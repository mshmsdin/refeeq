@echo off
chcp 65001 > nul
title منصة أرشيف المكتبة الشيعية للمناظرات
color 0E

echo ======================================================================
echo           منصة أرشيف المكتبة الشيعية والبحث المتقدم بالـ OCR
echo ======================================================================
echo.

cd /d "%~dp0"

echo [*] جاري فحص وتشغيل خادم المنصة الموحد (الواجهة + الـ API + محرك OCR)...
start "خادم المكتبة الشيعية الموحد (Port 3001)" cmd /k "cd /d ""%~dp0server"" && node server.js"

timeout /t 2 > nul

echo.
echo [*] جاري فتح المنصة في المتصفح تلقائياً...
start http://localhost:3001

echo.
echo ======================================================================
echo   تم تشغيل النظام بنجاح!
echo   - رابط المنصة الرئيسي: http://localhost:3001
echo   - رابط الشبكة المحلية: http://192.168.1.211:3001
echo.
echo   (اترك هذه النافذة مفتوحة طوال فترة استخدام المنصة أو البث)
echo ======================================================================
echo.
pause
