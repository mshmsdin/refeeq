  "verses": [
    {
      "chapter": 3,
      "verse": 6,
      "text_ar": "فتحت أربعة أبواب بيتي، كلُّ منها كان تحت مسؤولية حارسٍ يُرى ما إذا كان يأتي أحدٌ يطلب الصدقة، وما إذا كان يراني جالسًا عند أحد الأبواب ليتسنى له الخروج من الباب الآخر وأخذ ما يحتاجه."
    },
    {
      "chapter": 3,
      "verse": 7,
      "text_ar": "وكان لدي أيضًا ثلاثون مائدةً ثابتةً في جميع الأوقات للأغراب فقط، كما كان لدي اثنا عشر مائدةً مخصصةً للأرامل."
    },
    {
      "chapter": 3,
      "verse": 8,
      "text_ar": "وإذا جاء أحدٌ يطلب الصدقة، وجد طعامًا على مائدتي يأخذ ما يلزم منه، ولم أرفض أحدًا أن يغادر بابي وجائعًا."
    },
    {
      "chapter": 3,
      "verse": 9,
      "text_ar": "وكان لدي أيضًا ثلاثة آلاف وخمسمائة يوق من الثيران، واختُرت منها خمسمائة لتكلفها بالحرث."
    },
    {
      "chapter": 3,
      "verse": 10,
      "text_ar": "وبهذه أنجزت جميع الأعمال في كل حقل بأيدي الذين يتولونها، ووضعْتُ عائد محصولهم جانبًا للفقراء على موائدهم."
    }
  ]
