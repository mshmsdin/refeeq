  "verses": [
    {
      "chapter": 8,
      "text_ar": "لكي تعلموا أن قلبي سليم، فاسمعوا ما أسألكم:",
      "verse": 21
    },
    {
      "chapter": 8,
      "text_ar": "فإن الطعام يأتي من البطن، والماء تشربونه من الفم، ثم يخرج عبر الأذن نفسها، وعندما تحدر كليهما ليصيرا فضلات، يتفارقان مرة أخرى من؟",
      "verse": 22
    },
    {
      "chapter": 8,
      "text_ar": "وقال بلداد: \"إني لا أعلم\". فرددت عليه قائلاً: \"إن لم تكن تفهم حتى مراكب الجسد، فكيف تفهم مدارات السماء؟",
      "verse": 23
    },
    {
      "chapter": 8,
      "text_ar": "فرد صفور قائلاً: \"إننا لا نرتضي لأمر بعثة، ولكننا نريد أن نعلم هل أنت في حال ارتياح، وها إننا نرى أن عقلك لم يتزعزع",
      "verse": 24
    },
    {
      "chapter": 8,
      "text_ar": "ماذا تريدي الآن أن نعمل لك؟ هانحن قد جئنا إليك وأتينا بأطباء ثلاثة ملوك، وإن شئت فستشفى بتوسطهم",
      "verse": 25
    }
  ]
}
