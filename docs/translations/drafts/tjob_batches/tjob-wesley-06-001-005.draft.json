  "verses": [
    {
      "chapter": 6,
      "text_ar": "فإِذْ أَقْبَلَتِ امْرَأَتِي عَلَى حَالٍ وَشَيْخُوعٍ خَاصِمَةٌ، وَبَكَاؤُهَا صَاحَتْ: «إِزَائِي! تَتَبَلَّغُ إِلَى دِرْهِمٍ؟ كَمْ يَوْمًا تَضَعُ حَيَاتَكَ عَلَى بَعِيرٍ، وَهَذِهِ لَا تُنَاصِحُكَ عَنْ رَدِّ حَاجَتِكَ؟» وَفِي كُلِّ مَرَّةٍ إِنَّهَا لَا تَكَلَّمَتْ، وَإِذْ أَبْصَرَتهَا، قَالَ: «يَا ابْنَتِي، إحْذَاكِ قَدْ بَكَيتِ يَا ابْنَتِي!» وَالْمَكَارِهُ الْكَثِيرَةُ وَاحْتِرَاقُ النَّارِ الَّذِي اتَّصَلَ عَلَى عَجْلَه، وَالْحُزْنُ الّذِي ذَبَلَهُ وَاحْتَرَقَ كُلُّ وَاحِدٍ مِنْبِحَالَة مَاسَوِيَة.",
      "verse": 1
    },
    {
      "chapter": 6,
      "text_ar": "وَأَنَا ضَاحِلٌ مِنْ مَكَانٍ إِلَى مَكَانٍ، كَأَنِّي رَبٌّ لِلنَّاسِ، فَإِنَّ ذَلِكَ ذَهَبَ مِنَ الْأَرْضِ.",
      "verse": 2
    },
    {
      "chapter": 6,
      "text_ar": "وَأَبْنَائِي وَالْبِنَاتُ الّذِينَ حَمَلْتُهُمْ بَيْنَ فَخِذَيَّ، وَشَقَائِي وَجَعِي، صَارَتَا بَاطِلًا.",
      "verse": 3
    },
    {
      "chapter": 6,
      "text_ar": "وَأَنْتَ جَالِسٌ فِي بِئْرٍ وَرِجْلٌ سَاقِطَةٌ، تُقْصِرُ لَيْلَكَ فِي بُرُودَةِ الهَوَاءِ.",
      "verse": 4
    },
    {
      "chapter": 6,
      "text_ar": "وَأَنَا تَعَبٌ فِي كُلِّ مَرَّةٍ وَاحِدَةٍ، يَوْمًا وَلَيْلًا، حَتَّى قَدِيرٌ أَنْ يُؤْتِيكَ خُبْزًا.",
      "verse": 5
    }
  ]
}
