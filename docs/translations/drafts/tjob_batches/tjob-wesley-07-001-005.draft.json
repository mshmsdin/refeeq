  "verses": [
    {
      "chapter": 7,
      "text_ar": "في ذلك الوقت، سمع الملوك ما حدث لي، فقاموا وجاءوا إليّ من كل أرض ليزوروني ويواسوني.",
      "verse": 1
    },
    {
      "chapter": 7,
      "text_ar": "وحينما اقتربوا مني، صرخوا بصوت عالٍ، وقطّع كل واحد من ثيابه.",
      "verse": 2
    },
    {
      "chapter": 7,
      "text_ar": "وبعد أن سجدوا ووضعوا رؤوسهم على الأرض، جلسوا معي سبعة أيام وسبعة ليالٍ، ولم يقل أحد كلمة.",
      "verse": 3
    },
    {
      "chapter": 7,
      "text_ar": "كانوا أربعة في العدد: إليبلاز، ملك تيمن، وبالاد، وسوافر، وعيليهو.",
      "verse": 4
    },
    {
      "chapter": 7,
      "text_ar": "وعندما جلسوا، تباحثوا في ما حدث لي.",
      "verse": 5
    }
  ]
}
