  "verses": [
    {
      "chapter": 7,
      "verse": 31,
      "text_ar": "أأنتَ ذلك الذي كان له شمعيات من الذهب موضوعة على قواعد من الفضة؛ والآن يجب أن تشتاق إلى بريق القمر الطبيعي [\"أين ذهبت مجدك إذًا!\"]"
    },
    {
      "chapter": 7,
      "verse": 32,
      "text_ar": "أأنتَ الذي كان له مرهم مصنوع من توابل اللبان، والآن أنت في حالة نبذ! [أين ذهبت مجدك إذًا!]"
    },
    {
      "chapter": 7,
      "verse": 33,
      "text_ar": "أأنتَ ذلك الذي كان يضحك على الفاسدين والآثمين للاستهزاء، والآن أصبحت موضع سخرية للجميع! [أين ذهبت مجدك إذًا]"
    },
    {
      "chapter": 7,
      "verse": 34,
      "text_ar": "وعندما صرخ إليفاز لفترة طويلة ونوح، بينما انضم إليه الجميع، فأصبح الضجيج عظيمًا جدًا، قلت لهم:"
    },
    {
      "chapter": 7,
      "verse": 35,
      "text_ar": "اصمتوا وسأُريكم عرشي، ومجد بريقه: مجدي سيكون أبديا."
    }
  ]
