  "verses": [
    {
      "chapter": 11,
      "text_ar": "وأخذت فمها يتكلم بلهجة الحكام السماويين (الأرخبون)، ورنّمت بتسبيحة عمل الموضع العالي، ومن أراد أن يعرف عمل السموات فليطلع على ترانيم كاسيا.",
      "verse": 26
    },
    {
      "chapter": 11,
      "text_ar": "حينئذٍ تنطقت الابنة الأخرى التي تدعى قرن أمالثيا (قرن الكحل)، وتكلم فمها بلغة أهل الأعالي، لأن قلبها تحوّل وارتفع فوق الأمور العالمية.",
      "verse": 27
    },
    {
      "chapter": 11,
      "text_ar": "تكلمت بلهجة الكروبيم، مرتلة تسبيح حاكم القوات الكونية (الفضائل) وممجدة مجده.",
      "verse": 28
    },
    {
      "chapter": 11,
      "text_ar": "ومن أراد أن يتبع آثار «مجد الآب» سيجدها مكتوبة في صلوات قرن أمالثيا.",
      "verse": 29
    }
  ]
