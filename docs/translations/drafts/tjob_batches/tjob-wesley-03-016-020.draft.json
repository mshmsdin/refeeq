  "verses": [
    {
      "chapter": 3,
      "text_ar": "وفائض ربحنا يمكننا أن نعطيه مساعدة للفقراء، وحينئذ نرد إليك مالك الخاص.",
      "verse": 16
    },
    {
      "chapter": 3,
      "text_ar": "ولما سمعت هذا، فرحت أن يأخذوا هذا كله مني لأجل ممارسة الصدقة للفقراء.",
      "verse": 17
    },
    {
      "chapter": 3,
      "text_ar": "وبقلب راغب أعطيتهم ما أرادوا، وقبلت سندهم المكتوب، ولم أرد أن آخذ منهم أي ضمان آخر سوى الوثيقة المكتوبة.",
      "verse": 18
    },
    {
      "chapter": 3,
      "text_ar": "وذهبوا إلى الخارج وأعطوا للفقراء بحسب نجاحهم.",
      "verse": 19
    },
    {
      "chapter": 3,
      "text_ar": "غير أن بعض بضائعهم كانت تضيع مراراً كثيرة على الطريق أو في البحر، أو كانوا يُسلبونها.",
      "verse": 20
    }
  ]
