  "verses": [
    {
      "chapter": 7,
      "text_ar": "يهلك العالم بأسره وتزول مجده، وكل من يتمسك به يبقى في الأسفل، أما عرشي ففي العالم العلوي ومجده وبهائه سيكونان عن يمين المخلص في السموات.",
      "verse": 36
    },
    {
      "chapter": 7,
      "text_ar": "عرشي قائم في حياة \"القديسين\" ومجده في العالم غير البائد.",
      "verse": 37
    },
    {
      "chapter": 7,
      "text_ar": "لأن الأنهار ستجف وغطرستها ستنزل إلى عمق الهاوية، أما جداول أرضي التي نُصب فيها عرشي فلن تجف، بل ستظل ثابتة بلا انكسار في القوة.",
      "verse": 38
    },
    {
      "chapter": 7,
      "text_ar": "الملوك يهلكون والحكام يزولون، ومجدهم وفخرهم كظل في مرآة، أما ملكوتي فيدوم إلى أبد الآبدين، ومجده وجماله في مركبة أبي.",
      "verse": 39
    }
