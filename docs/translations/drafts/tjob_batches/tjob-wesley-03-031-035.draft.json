  "verses": [
    {
      "chapter": 3,
      "text_ar": "لأن اللبن فاض بكثرة حتى تخثر زبدة على التلال وعلى جانب الطريق؛ وعند الصخور والتلال ربضت الماشية التي ولدت صغارها.",
      "verse": 31
    },
    {
      "chapter": 3,
      "text_ar": "لأن خدامي تعبوا وهم يحفظون طعام الأرامل والفقراء ويقسمونه إلى قطع صغيرة.",
      "verse": 32
    },
    {
      "chapter": 3,
      "text_ar": "لأنهم كانوا يلعنون ويقولون: \"ليت لنا من لحمه لنشبع\"، مع أنني كنت لطيفاً جداً معهم،",
      "verse": 33
    },
    {
      "chapter": 3,
      "text_ar": "وكان عندي أيضاً ستة قيام [وستة عبيد ليعزفوا على القيام] وأيضاً كيثارة، وذات عشرة أوتار، وكنت أضرب عليها خلال النهار.",
      "verse": 34
    },
    {
      "chapter": 3,
      "text_ar": "وأخذت الكيثارة، وكانت الأرامل يتدبن بعد وجباتهن.",
      "verse": 35
    }
  ]
