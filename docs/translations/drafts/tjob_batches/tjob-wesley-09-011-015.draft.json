  "verses": [
    {
      "chapter": 9,
      "text_ar": "ولكنني قلت لهم: «انهضوني لكي أقف»، فرفعوني ممسكين بذراعيَّ من الجانبين.",
      "verse": 11
    },
    {
      "chapter": 9,
      "text_ar": "فوقفت منتصبًا، وأنطقت أولاً بتسبيح الله وبعد الصلاة قلت لهم: «انظروا بعيونكم إلى الشرق».",
      "verse": 12
    },
    {
      "chapter": 9,
      "text_ar": "فنظرا ورأيا أولادي تيجاناً بقرب مجد الملك، حاكم السماء.",
      "verse": 13
    },
    {
      "chapter": 9,
      "text_ar": "ولما رأت زوجتي سيتيس ذلك، سقطت على الأرض وسجدت لله قائلة: «الآن عرفتُ أن ذكري باقٍ لدى الرب».",
      "verse": 14
    },
    {
      "chapter": 9,
      "text_ar": "وبعد أن قالت هذا وجاء المساء، ذهبت إلى المدينة، عائدة إلى السيد الذي كانت تخدمه أمةً، واضطجعت عند معلف الماشية وماتت هناك من الإرهاق.",
      "verse": 15
    }
  ]
