  "verses": [
    {
      "chapter": 5,
      "text_ar": "وخرجت من المدينة في رعب شديد وويل وجلست على مزبلة بينما كان جسدي مقروضاً بالدود.",
      "verse": 6
    },
    {
      "chapter": 5,
      "text_ar": "وبللت الأرض برطوبة جسدي المتقرح، لأن الصديد كان يسيل من جسدي، وغطاه كثير من الدود.",
      "verse": 7
    },
    {
      "chapter": 5,
      "text_ar": "وعندما زحف دودة واحدة عن جسدي، أرجعتها قائلة: \"ابْقَ في الموضع الذي وُضِعْتَ فيه حتى يأمرك من أرسلك إلى مكان آخر.\"",
      "verse": 8
    },
    {
      "chapter": 5,
      "text_ar": "هكذا احتملت لمدة سبع سنوات، جالساً على مزبلة خارج المدينة بينما كنت مصاباً بالضربة.",
      "verse": 9
    },
    {
      "chapter": 5,
      "text_ar": "ورأيت بعيني أطفالي الذين طالما اشتقْتُ إليهم [تحملهم الملائكة إلى السماء]",
      "verse": 10
    }
  ]
