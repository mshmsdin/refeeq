                   {
                       "chapter":  16,
                       "text_ar":  "هوذا الطعام سيكون رخيصاً جداً على الأرض بحيث يظنون أنهم في حالة جيدة، وحتى عندئذ سترتفع البلايا على الأرض: السيف، والجوع، والاضطراب العظيم.",
                       "verse":  21
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "لأن كثيرين ممن يسكنون على الأرض سيتهلكون بالجوع، والآخرون الذين ينجون من الجوع، سيهلكهم السيف.",
                       "verse":  22
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "ستطرح الجثث مثل الزبل، ولن يكون هناك من يعزيهم؛ لأن الأرض ستترك مقفرة، وستطرح مدنها أرضاً.",
                       "verse":  23
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "لن يبقى فلاح لفلاحة الأرض أو لبذرها.",
                       "verse":  24
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "الأشجار ستعطي ثمراً، ولكن من سيجمعه؟",
                       "verse":  25
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "العنب سينضج، ولكن من سيدوسه؟ لأنه في كل الأماكن سيكون هناك عزلة عظيمة؛",
                       "verse":  26
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "لأن الإنسان الواحد سيشتهي أن يرى آخر، أو يسمع صوته.",
                       "verse":  27
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "لأنه من المدينة سيبقى عشرة، واثنان من الحقل، اللذين اختبأا في الغابات الكثيفة، وفي شقوق الصخور.",
                       "verse":  28
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "كما في بستان زيتون قد تبقى في كل شجرة ثلاث أو أربع زيتونات،",
                       "verse":  29
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "أو كما عندما يجمع الكرم، تبقى بعض العناقيد لأولئك الذين يفتشون باجتهاد في الكرم،",
                       "verse":  30
                   }
               ]
}
