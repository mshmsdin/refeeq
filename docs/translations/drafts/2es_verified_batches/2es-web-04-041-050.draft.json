    "verses":  [
                   {
                       "chapter":  4,
                       "text_ar":  "ثم قلت لا يا سيد هكذا لا يكون فقال لي في الجحيم مخادع النفوس مثل البطن",
                       "verse":  41
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "لأنه كما أن المرأة الحامل تسرع أن تنجو من ألم المخاض هكذا هذه الأماكن تسرع أن تسلم ما أودع فيها منذ البداءة",
                       "verse":  42
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "وحينئذ يرى لك ما تشتهي أن تراه",
                       "verse":  43
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فأجبت قلت إن كنت قد وجدت نعمة في عينيك وإن كان ممكنا وإن كنت مستحقا",
                       "verse":  44
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فأرني هذا أيضا هل ما بقي أكثر مما مضى أم انقضى منا القسم الأعظم",
                       "verse":  45
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "لأني أعرف ما مضى ولكني لا أعرف ما سيأتي",
                       "verse":  46
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فقال لي قف عن يمني فأفسر لك المثل",
                       "verse":  47
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فوقفت ونظرت وإذا أتون نار ملتهبة يمر أمامي وحدث لما مضى اللهب أني نظرت فرأيت الدخان باقيا",
                       "verse":  48
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "وبعد هذا عبر أمامي سحاب ماء وأنزل مطرا كثيرا بعاصفة ولما انقضت العاصفة بقيت منه القطرات",
                       "verse":  49
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فقال لي تأمل في نفسك كما أن المطر أكثر من القطرات والنار أعظم من الدخان هكذا القسم الذي مضى كان أعظم بكثير أما القطرات والدخان فبقيا",
                       "verse":  50
                   }
               ]
