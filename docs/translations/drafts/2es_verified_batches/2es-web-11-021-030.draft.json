                   {
                       "chapter":  11,
                       "text_ar":  "وأقام أيضا بعض منها لكنها لم تملك.",
                       "verse":  21
                   },
                   {
                       "chapter":  11,
                       "text_ar":  "وبعد هذا نظرت وإذا الأجنحة الاثنا عشر قد اختفت مع جناحين من الأجنحة الصغيرة.",
                       "verse":  22
                   },
                   {
                       "chapter":  11,
                       "text_ar":  "ولم يبق شيء على جسم النسر سوى الرؤوس الثلاثة التي استراحت وستة أجنحة صغيرة.",
                       "verse":  23
                   },
                   {
                       "chapter":  11,
                       "text_ar":  "فرأيت وإذا بجناحين صغيرين انفصلا عن الستة وبقيا تحت الرأس الذي على الجانب الأيمن، وبقي أربعة في مكانها.",
                       "verse":  24
                   },
                   {
                       "chapter":  11,
                       "text_ar":  "فرأيت وإذا بهذه الأجنحة التحتية خططت لأن تقيم نفسها وتملك.",
                       "verse":  25
                   },
                   {
                       "chapter":  11,
                       "text_ar":  "فرأيت وإذا بواحد أقيم لكنه اختفى بعد قليل.",
                       "verse":  26
                   },
                   {
                       "chapter":  11,
                       "text_ar":  "وفعل الثاني هكذا أيضا، واختفى أسرع من الأول.",
                       "verse":  27
                   },
                   {
                       "chapter":  11,
                       "text_ar":  "فرأيت وإذا بالاثنين اللذين بقيا خططا أيضا فيما بينهما للملك.",
                       "verse":  28
                   },
                   {
                       "chapter":  11,
                       "text_ar":  "وفيما كانا يفكران في ذلك، إذا بواحد من الرؤوس المستريحة استيقظ، وهو الذي كان في الوسط، لأنه كان أعظم من الرأسين الآخرين.",
                       "verse":  29
                   },
                   {
                       "chapter":  11,
                       "text_ar":  "ورأيت كيف انضم إلى الرأسين الآخرين معه.",
                       "verse":  30
                   }
               ]
