    "verses":  [
                   {
                       "chapter":  16,
                       "text_ar":  "كذا أيضا في تلك الأيام يبقى ثلاثة أو أربعة ممن يفتشون بيوتهم بالسيف.",
                       "verse":  31
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "وتترك الأرض مقفرة وحقولها للشوك وطرقها وكل سبلها تنبت حسكا لأنه لا يمر بها غنم.",
                       "verse":  32
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "وتنوح العذارى إذ ليس لهن أزواج. وتنوح النساء إذ ليس لهن رجال. وتنوح بناتهتن إذ ليس لهن معينون.",
                       "verse":  33
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "يهلك أزواجهن في الحروب ويموت رجالهن بالجوع.",
                       "verse":  34
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "اسمعوا الآن هذه الأشياء وافهموها يا عبيد الرب.",
                       "verse":  35
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "هوذا كلمة الرب فاقبلوها ولا تشكوا في الأمور التي يتكلم بها الرب.",
                       "verse":  36
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "هوذا البلايا تقترب ولا تتباطأ.",
                       "verse":  37
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "وكما أن المرأة الحامل في الشهر التاسع عندما تقترب ساعة ولادتها تحيط برحمها أوجاع شديدة في غضون ساعتين أو ثلاث وعندما يخرج الولد من الرحم لا يكون هناك إبطاء البتة،",
                       "verse":  38
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "هكذا أيضا البلايا لن تتباطأ في المجيء على الأرض. وتئن المسكونة وتأخذها الأوجاع من كل جانب.",
                       "verse":  39
                   },
                   {
                       "chapter":  16,
                       "text_ar":  "يا شعبي اسمعوا كلامي وتأهبوا للحرب وكونوا في تلك البلايا كغرباء على الأرض.",
                       "verse":  40
                   }
               ]
