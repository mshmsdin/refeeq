    "verses":  [
                   {
                       "chapter":  7,
                       "text_ar":  "ولما فرغت من تكلَم بهذه الكلمات، أُرسِل إليَ الملاك الذي أُرسِل إليَ في الليالي السابقة.",
                       "verse":  1
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "فقال لي: «قم، يا عزرا، واسمع الكلمات جئتُ لأقولها لك».",
                       "verse":  2
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "فقلتُ: «تكلَم يا رب». ثم قال لي: «هناك بحرٌ موضوعٌ في مكان واسع ليكون عريضاً وشاسعاً،",
                       "verse":  3
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "ولكن مدخله موضوع في مكان ضيق ليكون مثل النهر.",
                       "verse":  4
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "كل من يرغب في النزول إلى البحر لينظر إليه أو لِيحكمه، إن لم يجُز عبر المدخل الضيق، فكيف يمكنه الدخول إلى الجزء العريض؟",
                       "verse":  5
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "وأمرٌ آخر أيضاً: توجد مدينة مبنية وموضوعة في أرض سهلية، ومليئة بكل الخيرات،",
                       "verse":  6
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "ولكن مدخلها ضيق، وموضوع في مكان خطير للسقوط، وله نارٌ عن اليمين، ومياه عميقة عن اليسار.",
                       "verse":  7
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "وهناك طريق واحد فقط بينهما، أي بين النار والماء، بحيث يمكن لشخص واحد فقط أن يسير فيه في المرة الواحدة.",
                       "verse":  8
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "إذا أُعطيت هذه المدينة الآن لإنسان ميراثاً، فإن لم يجُز الوارث الخطر الذي أمامه، فكيف سيتلقى ميراثه؟»",
                       "verse":  9
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "قلتُ: «هذا صحيح يا رب». ثم قال لي: «هكذا أيضاً هو نصيب إسرائيل».",
                       "verse":  10
                   }
               ]
}
