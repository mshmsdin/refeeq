    "verses":  [
                   {
                       "chapter":  8,
                       "verse":  1,
                       "text_ar":  "أجابني: «العلِي صنع هذا العالم للكثيرين، لكن العالم الآتي للقليلين.»"
                   },
                   {
                       "chapter":  8,
                       "verse":  2,
                       "text_ar":  "الآن سأحكي لك مثلًا يا أَسْدَرَاس. كما تسأل الأرض، فتقول لك إنها تعطي الكثير من الطين الذي تُصنع منه الأواني الفخارية، لكن القليل من الغبار الذي يُستخرج منه الذهب. كذلك مسار العالم الحالي."
                   },
                   {
                       "chapter":  8,
                       "verse":  3,
                       "text_ar":  "الكثير خُلقوا، لكن القليل فقط سيُنجى."
                   },
                   {
                       "chapter":  8,
                       "verse":  4,
                       "text_ar":  "أجبت: «اشرب ملئ الفهم يا نفسي، ودع قلبي يلتهم الحكمة.»"
                   },
                   {
                       "chapter":  8,
                       "verse":  5,
                       "text_ar":  "لأنك جئت إلى هنا بعيدًا عن إرادتك، وتغادر ضد إرادتك، فقد منحك الوقت قصيرًا لتعيش."
                   },
                   {
                       "chapter":  8,
                       "verse":  6,
                       "text_ar":  "يا رب فوقنا، امنح عبدك أن نصلي أمامك، وامنحنا بذورًا لقلوبنا وزرعًا لفهمنا، لينمو منه ثمرة، بحيث يستطيع كل فاسد، الذي يحمل شبيه الإنسان، أن يعيش."
                   },
                   {
                       "chapter":  8,
                       "verse":  7,
                       "text_ar":  "لأنك وحدك موجود، ونحن جميعًا عمل يدك، كما قلت."
                   },
                   {
                       "chapter":  8,
                       "verse":  8,
                       "text_ar":  "لأنك تعطي الحياة للجسم الذي يتشكل الآن في الرحم، وتمنحه أعضاء، فإن مخلوقك يُحفظ بالنار والماء، ويستمر عملك لتسعة أشهر كخلقة تُخلق فيه."
                   },
                   {
                       "chapter":  8,
                       "verse":  9,
                       "text_ar":  "لكن ما يُحفظ وما يُحفظ له سيُحفظ بقدرتك. عندما يفرغ الرحم مرة أخرى ما نمت فيه،"
                   },
                   {
                       "chapter":  8,
                       "verse":  10,
                       "text_ar":  "أمرت أن يُعطى من أجزاء الجسم، أي من الثديين، حليبًا، وهو ثمرة الثدي."
                   }
               ]
}
