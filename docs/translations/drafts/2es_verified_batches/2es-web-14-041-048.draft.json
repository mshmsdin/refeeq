  "verses": [
    {
      "text_ar": "انفتح فمي ولم أغلقه بعد.",
      "chapter": 14,
      "verse": 41
    },
    {
      "text_ar": "وأعطى العلي فهماً للرجال الخمسة، فكتبوا تباعاً الأمور التي قيلت لهم بحروف لم يكونوا يعرفونها، وجلسوا أربعين يوماً. وكانوا يكتبون في النهار، وفي الليل يأكلون خبزاً.",
      "chapter": 14,
      "verse": 42
    },
    {
      "text_ar": "أما أنا فتكلمت في النهار، ولم أصمت في الليل.",
      "chapter": 14,
      "verse": 43
    },
    {
      "text_ar": "هكذا في أربعين يوماً، كُتبت أربعة وتسعون كتاباً.",
      "chapter": 14,
      "verse": 44
    },
    {
      "text_ar": "وحدث عندما كملت الأيام الأربعون، أن العلي كلمني قائلاً: \"الكتب الأولى التي كتبتها، انشرها علانية، وليقرأها المستحقون وغير المستحقين؛",
      "chapter": 14,
      "verse": 45
    },
    {
      "text_ar": "أما السبعون الأخيرة فاحفظها لكي تسلمها إلى الحكماء من شعبك؛",
      "chapter": 14,
      "verse": 46
    },
    {
      "text_ar": "لأنه فيهم نبع الفهم، ومصدر الحكمة، ونهل المعرفة.\"",
      "chapter": 14,
      "verse": 47
    },
    {
      "text_ar": "ففعلت هكذا.",
      "chapter": 14,
      "verse": 48
    }
  ]
}
