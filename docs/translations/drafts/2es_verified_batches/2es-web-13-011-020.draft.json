                   {
                       "chapter":  13,
                       "text_ar":  "وكانت هذه كلها تمتزج معا: سيل النار، والنفخ الملتهب، والعاصفة العظيمة، وسقطت على هجوم الجمهور الذي كان مستعدا للقتال، وأحرقت كل واحد منهم، بحيث ظهر فجأة جمهور لا يُحصى أنه لم يكن شيئاً سوى رماد تراب ورائحة دخان. ولما رأيت هذا تعجبت.",
                       "verse":  11
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "وبعد ذلك، رأيت نفس الرجل ينزل من الجبل، ويستدعي إليه جماعة أخرى مسالمة.",
                       "verse":  12
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "أتى إليه كثير من الناس. وكان بعضهم فرحين، وبعضهم حزانى، وبعضهم مقيدين، وآخرون أحضروا بعض أولئك كتقدمات. حينئذ بخوف عظيم استيقظت وصليت إلى العلي وقلت:",
                       "verse":  13
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "أنت أريت عبدك هذه العجائب منذ البدء، وحسبتني مستحقا لأن تقبل صلاتي.",
                       "verse":  14
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "والآن أرني أيضا تفسير هذا الحلم.",
                       "verse":  15
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "لأنه كما أتصور في فهمي، الويل للذين سيُتركون في تلك الأيام! وأكثر بكثير الويل للذين لا يُتركون!",
                       "verse":  16
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "لأن الذين لم يُتركوا سيكونون في حزن،",
                       "verse":  17
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "إذ يفهمون الأمور المخزونة في الأيام الأخيرة، ولكنهم لا يبلغونها.",
                       "verse":  18
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "ولكن الويل لهم أيضا الذين يُتركون، لأنهم سيَرَوْن أخطاراً عظيمة وضيقاً شديداً، كما تُعلن هذه الأحلام.",
                       "verse":  19
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "مع ذلك فهو خير للإنسان أن يكون في خطر وأن يأتي إلى هذه الأمور، من أن يزول كسحابة خارج العالم، ولا يرى الأمور التي ستحدث في الأيام الأخيرة. فأجابني،",
                       "verse":  20
                   }
               ]
