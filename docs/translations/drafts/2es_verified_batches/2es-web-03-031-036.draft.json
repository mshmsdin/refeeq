                       "chapter":  3,
                       "text_ar":  "ولم تبين كيف يمكن إدراك طريقك. أأعمال بابل أفضل من أعمال صهيون؟",
                       "verse":  31
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "أم أمة أخرى تعرفك سوى إسرائيل؟ أو أي أسباط آمنت بعهودك هكذا كأسباط يعقوب هؤلاء؟",
                       "verse":  32
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "ومع ذلك لا تظهر أجرتهم، وعملهم بلا ثمر، لأني ذهبت هنا وهناك بين الأمم ورأيت أنهم يفيضون غنى ولا يفكرون في وصاياك.",
                       "verse":  33
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "فزن إذن آثامنا الآن في الميزان، وآثام الساكنين في العالم أيضاً، وهكذا يُوجد لأي جهة يميل الكفة.",
                       "verse":  34
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "أو متى كان الساكنون على الأرض لم يخطئوا في عينيك؟ أو أي أمة حفظت وصاياك هكذا حسناً؟",
                       "verse":  35
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "ستجد بعض الناس بأسمائهم الذين حفظوا فرائضك، ولكنك لن تجد أمماً.",
                       "verse":  36
                   }
