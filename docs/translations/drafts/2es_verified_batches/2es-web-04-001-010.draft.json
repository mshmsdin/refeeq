    "verses":  [
                   {
                       "chapter":  4,
                       "text_ar":  "فأجابني الملاك الذي أرسل إلي، والذي كان اسمه أوريئيل،",
                       "verse":  1
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "وقال لي: لقد قصر فهمك تماماً في أمر هذا العالم، فهل تظن أنك تستطيع أن تدرك طريق العلي؟",
                       "verse":  2
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فقلت: نعم يا سيدي. فأجابني: لقد أرسلت لأريك ثلاثة طرق، وأعرض عليك ثلاثة أمور.",
                       "verse":  3
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فإن استطعت أن تحل لي واحداً منها، فسأريك أيضاً الطريق الذي تشتهي أن تراه، وأعلمك لماذا القلب شرير.",
                       "verse":  4
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فقلت: تكلم يا سيدي. فقال لي: اذهب، زن لي وزن النار، أو قس لي نفخة الريح، أو استرجع لي اليوم الذي مضى.",
                       "verse":  5
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فأجبت وقلت: من من بني البشر يستطيع أن يفعل هذا، حتى تسألني عن مثل هذه الأمور؟",
                       "verse":  6
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فقال لي: لو سألتك: كم مسكناً في قلب البحر؟ أو كم ينبوعاً في رأس غماقة الهاء؟ أو كم مجرى مائياً فوق الجلد؟ أو ما هي مخارج الجهاء؟ أو ما هي مداخل الفردوس؟",
                       "verse":  7
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "لربما قلت لي: لم أنزل قط إلى الغماقة، ولا إلى الجهاء بعد، ولا صعدت إلى السماء قط.",
                       "verse":  8
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "ولكن الآن لم أسالك إلا عن النار والريح واليوم، وهي أمور اختبرتها ولا يمكنك أن تنفصل عنها، ومع ذلك لم تعطني عنها أي جواب.",
                       "verse":  9
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "ثم قال لي أيضاً: لا يمكنك أن تفهم أمور الخاصة التي نشأت معها.",
                       "verse":  10
                   }
               ]
}
