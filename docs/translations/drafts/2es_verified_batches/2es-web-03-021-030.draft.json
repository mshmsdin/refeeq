    "verses":  [
                   {
                       "chapter":  3,
                       "text_ar":  "لان آدم الاول لما حمل قلبا شريرا تعدى وغلب وكذلك جميع الذين نسلوه",
                       "verse":  21
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "فصار المرض لازما والشريعة كانت في قلب الشعب مع شر الاصل فزالت الخيرات وبقى الشر",
                       "verse":  22
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "ومضت الاوقات وانقضت السنون فاقمت عبدا لك اسمه داود",
                       "verse":  23
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "الذي امرته ان يبني مدينة لاسمك وان يقرب لك فيها محرقات مما هو لك",
                       "verse":  24
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "فلما صنع هذا سنين كثيرة عمل الساكنون في المدينة الشر",
                       "verse":  25
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "في كل شيء عاملين كما عمل آدم وكل اجياله لانهم هم ايضا كان لهم قلب شرير",
                       "verse":  26
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "فاسلمت مدينتك لايدي اعدائك",
                       "verse":  27
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "فقلت في نفسي افعل الساكنين في بابل افضل وبذلك تسلطت على صهيون",
                       "verse":  28
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "فانه كان لما جئت هنا اني رايت فجورات بلا عدد ورات نفسي خطاة كثيرين في هذه السنة الثلاثين حتى غشي علي قلبي",
                       "verse":  29
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "لاني رايت كيف تحتملهم وهم يخطئون وتشفق على الفاجرين وتهلك شعبك وتبقي اعداءك",
                       "verse":  30
                   }
               ]
