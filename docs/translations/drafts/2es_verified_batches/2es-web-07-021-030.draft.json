    "verses":  [
                   {
                       "chapter":  7,
                       "text_ar":  "لان الله امر بصرامة اولئك الذين اتوا، حتى عندما اتوا، بما يجب عليهم فعله ليحيا، وما يجب عليهم مراعاته لتجنب العقاب.",
                       "verse":  21
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "مع ذلك، لم يكونوا طائعين له، بل تحدثوا ضده وتخيلوا لانفسهم اموراً باطلة.",
                       "verse":  22
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "لقد وضعوا خططاً ماكرة للشر، وقالوا علاوة على ذلك عن العلي إنه غير موجود، ولم يعرفوا طرقه.",
                       "verse":  23
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "لقد احتقروا شريعته وانكروا عهوده. ولم يكونوا امناء لفرائضه، ولم يقوموا باعماله.",
                       "verse":  24
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "لذلك، يا عزرا، للافراغ امور فارغة، وللامتلاء امور ممتلئة.",
                       "verse":  25
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "لانه هوذا، سيأتي الوقت، ويكون، عندما تحدث هذه العلامات التي اخبرتك بها من قبل، ان العروس ستظهر، بل والمدينة الخارجة، وسوف يُرى من هي محجوبة الآن عن الارض.",
                       "verse":  26
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "كل من ينجو من الشرور المتنبأ بها سيبصر عجائبي.",
                       "verse":  27
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "لان ابني يسوع سيُعلن مع اولئك الذين معه، والذين يبقون سيفرحون اربعمائة سنة.",
                       "verse":  28
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "بعد هذه السنوات سيموت ابني المسيح، مع كل اولئك الذين فيهم نسمة حياة.",
                       "verse":  29
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "حينئذ يتحول العالم الى الصمت القديم سبعة ايام، كما في البدء الاول، لكي لا يبقى انسان.",
                       "verse":  30
                   }
               ]
}
