  "verses": [
    {
      "chapter": 2,
      "verse": 41,
      "text_ar": "عدد أولادك الذين تشتاق إليهم قد تحقق. اسأل قوة الرب أن يقدّس شعبك الذين دُعوا منذ البداية."
    },
    {
      "chapter": 2,
      "verse": 42,
      "text_ar": "أنا أَزْرَس رأيت على جبل صهيون حشدًا عظيماً لا أستطيع عدّه، وجميعهم يسبّحون الرب بالأغاني."
    },
    {
      "chapter": 2,
      "verse": 43,
      "text_ar": "في وسطهم كان شابٌ ذو قامة عالية، أطول من جميع الآخرين، وضع على كل رأس منهم تيجان، وكان أرفع منهم. أُعجِبتُ كثيرًا بهذا."
    },
    {
      "chapter": 2,
      "verse": 44,
      "text_ar": "فسألت الملاك وقلت: «ما هؤلاء يا ربّي؟»"
    },
    {
      "chapter": 2,
      "verse": 45,
      "text_ar": "أجابني وقال: «هؤلاء الذين خلعوا لباس الفناء وارتدوا الخلود، واعترفوا باسم الله. الآن تُتوّجون وتنالون النخيل.»"
    },
    {
      "chapter": 2,
      "verse": 46,
      "text_ar": "فقلت للملاك: «من هو الشاب الذي يضع التيجان عليهم ويعطيهم النخل في أيديهم؟»"
    },
    {
      "chapter": 2,
      "verse": 47,
      "text_ar": "فأجابني وقال: «هو ابن الله الذي اعترفوا به في العالم». ثم بدأت أسبّح الذين وقفوا بشجاعة من أجل اسم الرب."
    },
    {
      "chapter": 2,
      "verse": 48,
      "text_ar": "فقال الملاك لي: «امضِ في طريقك وأخبر شعبي عن ما رأيت من أمور وما أعاجيب الرب الإله العظيمة التي رأيتها.»"
    }
  ]
}
