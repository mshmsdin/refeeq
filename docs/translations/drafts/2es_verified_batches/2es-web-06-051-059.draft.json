    "verses":  [
                   {
                       "chapter":  6,
                       "text_ar":  "أعطית بهيموث القسم الواحد الذي جف في اليوم الثالث لیسكن فیه? حیث توجد ألف تل?",
                       "verse":  51
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "أما لواياثان فأعطیته القسم السابع? أي القسم المائي? وحفظتهما لیؤكلا ممن تشاء وفي الوقت الذي تشاء.",
                       "verse":  52
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وفي الیوم السادس أمرت الأرض أن تنتج أمامك بهائم وحیوانات ودبابات.",
                       "verse":  53
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وعلى هذه أقمت أدم رئيساً على كل أعمالك التي صنعتها. ومنه خرجنا نحن جميعاً? الشعب الذي اخترته.",
                       "verse":  54
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "كل هذا تكلمت به قدامك يا رب? لأنك قلت إنك من أجلنا خلقت هذا العالم.",
                       "verse":  55
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "أما الأمم الأخرى التي هي أيضاً من نسل آدم? فقد قلت إنهم لا شيء ومثل البصاق? وشبهت كثرتهم بقطرة تسقط من دلو.",
                       "verse":  56
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "والآن يا رب? انظر إلى هذه الأمم التي تُحسب لا شيء? وكيف أنها تتسلط علينا وتلتهمنا.",
                       "verse":  57
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "أما نحن شعبك الذي دعوته بكَركَ البكر? ابنك الوحيد? ومحبوبك الغيور? فقد أُسلمنا إلى أيديهم.",
                       "verse":  58
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "فإن كان العالم قد صُنع من أجلنا? فلماذا لا نرتث عالمنا ميراثاً؟ إلى متى يستمر هذا؟",
                       "verse":  59
                   }
               ]
}
