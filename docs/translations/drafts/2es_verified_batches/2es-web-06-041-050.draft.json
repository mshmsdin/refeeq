    "verses":  [
                   {
                       "chapter":  6,
                       "text_ar":  "وفي اليوم الثاني صنعت أيضا روح الفلك وأمرته أن يقسم ويفصل المياه، لكي يصعد جزء منها ويبقى الآخر تحته.",
                       "verse":  41
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وفي اليوم الثالث أمرت أن تجتمع المياه في الجزء السابع من الأرض. وجففت ستة أجزاء وأبقيتها، لكي يخدمك منها ما يُزرع ويُفلح.",
                       "verse":  42
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "لأنه ما إن خرجت كلمتك حتى تم العمل.",
                       "verse":  43
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وفوراً نبتت ثمار عظيمة لا تُحصى، بمذاقات كثيرة لطيفة، وأزهار بألوان لا تُبارى، وعطور ذات رائحة زكية جداً. وقد تم ذلك في اليوم الثالث.",
                       "verse":  44
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وفي اليوم الرابع أمرت أن تشرق الشمس، ويعطي القمر ضوءه، وتكون النجوم في نظامها؛",
                       "verse":  45
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وأعطيتها أمراً لخدمة البشرية التي كان سيوُجد.",
                       "verse":  46
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وفي اليوم الخامس قلت للجزء السابع، حيث جُمِعت المياه، أن ينتج كائنات حية وطيوراً وأسماكاً؛ وهكذا كان.",
                       "verse":  47
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "حيث أنتج الماء الأبكم وعديم الحياة أشياء حية كما وُصي، لكي تسبح الأمم أعمالك العجيبة.",
                       "verse":  48
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "ثم حفظت كائنين حيّين. أحدهما سميته بهيموث، والآخر سميته لواياثان.",
                       "verse":  49
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وفصلت الواحد عن الآخر؛ لأن الجزء السابع، أعني حيث جُمِعت المياه، لم يكن ليحتويهما معاً.",
                       "verse":  50
                   }
               ]
}
