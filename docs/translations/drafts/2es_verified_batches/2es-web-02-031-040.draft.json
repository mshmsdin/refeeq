    "verses":  [
                   {
                       "chapter":  2,
                       "text_ar":  "اذكروا أولادكم الراقدين، فإني سأخرجهم من مخادع الأرض وأظهر لهم الرحمة، لأني رحوم، يقول الرب القدير.",
                       "verse":  31
                   },
                   {
                       "chapter":  2,
                       "text_ar":  "احتضنوا أولادكم حتى أتي، وأعلنوا لهم الرحمة، لأن ينابيع طافحة ونعمتي لن تزول.",
                       "verse":  32
                   },
                   {
                       "chapter":  2,
                       "text_ar":  "أنا عزرا، تلقيت أمراً من الرب على جبل حوريب لأذهب إلى إسرائيل، ولكن عندما جئت إليهم، رفضوني ورفضوا وصية الرب.",
                       "verse":  33
                   },
                   {
                       "chapter":  2,
                       "text_ar":  "لذلك أقول لكم، أيها الأمم الذين تسمعون وتفهمون: انتظروا راعيكم، فهو سيمنحكم راحة أبدية، لأن القريب الذي يأتي في نهاية الدهر قد اقتراب.",
                       "verse":  34
                   },
                   {
                       "chapter":  2,
                       "text_ar":  "كونوا مستعدين لمكافآت الملكوت، لأن النور الأبدي سيشرق عليكم إلى الأبد.",
                       "verse":  35
                   },
                   {
                       "chapter":  2,
                       "text_ar":  "اهربوا من ظل هذا العالم، وتقبلوا فرح مجدكم. إني أشهد مخلصي جهاراً.",
                       "verse":  36
                   },
                   {
                       "chapter":  2,
                       "text_ar":  "اقبلوا ما أتاكم به الرب، وتكونوا فرحين، شاكرين للذي دعاكم إلى الممالك السماوية.",
                       "verse":  37
                   },
                   {
                       "chapter":  2,
                       "text_ar":  "قوموا وقفوا، وانظروا عدد المكتومين في وليمة الرب.",
                       "verse":  38
                   },
                   {
                       "chapter":  2,
                       "text_ar":  "إن الذين انفصلوا عن ظل العالم قد نالوا حللاً مجيدة من الرب.",
                       "verse":  39
                   },
                   {
                       "chapter":  2,
                       "text_ar":  "استردي عددك كاملاً يا صهيون، وأحصي الذين لك والذين يلبسون الثياب البيضاء، والذين أكملوا ناموس الرب.",
                       "verse":  40
                   }
               ]
}
