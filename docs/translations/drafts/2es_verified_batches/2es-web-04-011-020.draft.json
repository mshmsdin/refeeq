    "verses":  [
                   {
                       "chapter":  4,
                       "text_ar":  "كيف يستطيع عقلك إذن أن يدرك طريق العلي؟ كيف يمكن لمن سبق أن أنهكه العالم الفاسد أن يفهم غير الفساد؟ ولماذا عندما سمعت هذا سقطت على وجهي",
                       "verse":  11
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "وقلت له: كان خيراً لنا لو لم نكن هنا قط، بدلاً من أن نأتي إلى هنا ونعيش في وسط الفجور، ونعاني، ولا نعرف لماذا.",
                       "verse":  12
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فأجابني وقال: خرجت غابة من أشجار الحقل وتشاوروا معاً،",
                       "verse":  13
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "وقالو: تعالوا! لنذهب ونصنع حرباً ضد البحر، لكي ينصرف عنا، ولكي نصنع لأنفسنا غابات أكثر.",
                       "verse":  14
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "كما تشاورت أمواج البحر أيضاً بنفس الطريقة، وقالت: تعالوا! لنصعد ونخضع غابة السهل، لكي نكسب هناك أيضاً مساحة أكبر.",
                       "verse":  15
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "كانت مشورة الخشب باطلة، لأن النار جاءت واستهلكتها.",
                       "verse":  16
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "وكذلك أيضاً مشورة أمواج البحر، لأن الرمل وقف وأوقفهم.",
                       "verse":  17
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "لو كنت قاضياً الآن بين هذين الاثنين، فأيهما تبرر، وأيهما تدين؟",
                       "verse":  18
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فأجبت وقلت: إنها مشورة حمقاء أخذاها كلاهما، لأن الأرض معطاة للخشب، ومكان البحر معطى ليحمل أمواجه.",
                       "verse":  19
                   },
                   {
                       "chapter":  4,
                       "text_ar":  "فأجابني حينئذ وقال: لقد أصدرت حكماً صحيحاً. فلماذا لا تحكم في قضيتك الخاصة؟",
                       "verse":  20
                   }
               ]
}
