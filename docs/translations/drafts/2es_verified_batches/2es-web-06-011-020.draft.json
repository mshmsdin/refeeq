    "verses":  [
                   {
                       "chapter":  6,
                       "text_ar":  "ثم أجبت وقلت: أيها السيد الرب، إن كنت قد وجدت نعمة في عينيك،",
                       "verse":  11
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "فأطلبت إليك أن تظهر لعبدك نهاية آياتك التي أريتني جزءاً منها في ليلة سابقة.",
                       "verse":  12
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "فأجابني وقال: قف على قدميك وستسمع صوتاً عظيماً.",
                       "verse":  13
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وإن تحرك المكان الذي تقف عليه جداً",
                       "verse":  14
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "فلا تخف عندما يتكلم، لأن الكلام هو عن النهاية، وأسس الأرض ستفهم",
                       "verse":  15
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "أن الخطاب هو عنها، وسوف ترتجف وتتزعزع لأنها تعلم أن نهايتها لابد أن تتغير.",
                       "verse":  16
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وحدث لما سمعت ذلك أني قمت على قدمي وصغيت، وإذا صوت يتكلم وصوته كصوت مياه كثيرة.",
                       "verse":  17
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "فقال: هوذا أيام تأتي حين أقترب لأفتقد الساكنين على الأرض،",
                       "verse":  18
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وحين أبحث في أمر الذين صنعوا الشر ظلماً بإثمهم، وحين تكتمل بلية صيون،",
                       "verse":  19
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وحين يُختم الدهر العتيد أن يزول، فحينئذ أظهر هذه الآيات: تفتح الأسفار أمام الجلد والكل يرون معاً.",
                       "verse":  20
                   }
               ]
