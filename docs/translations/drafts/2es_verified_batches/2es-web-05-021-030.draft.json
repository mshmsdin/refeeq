    "verses":  [
                   {
                       "chapter":  5,
                       "text_ar":  "وبعد سبعة أيام، عادت أفكار قلبي لتكون مؤلمة جدا بالنسبة لي،",
                       "verse":  21
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "واستعادت نفسي روح الفهم، وشرعت في التكلم بكلمات أمام العلي مرة أخرى.",
                       "verse":  22
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "قلت: أيها الرب السيد على جميع غابات الأرض، وكل أشجارها، لقد اخترت لنفسك كرمة واحدة.",
                       "verse":  23
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "ومن كل أراضي العالم اخترت لنفسك بلدا واحدا. ومن كل أزهار العالم، اخترت لنفسك زنبقة واحدة.",
                       "verse":  24
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "ومن كل أعماق البحر، ملأت لنفسك نهرا واحدا. ومن كل المدن المبنية، كرست صهيون لنفسك.",
                       "verse":  25
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "ومن كل الطيور المخلوقة سميت لنفسك حمامة واحدة. ومن كل المواشي التي صنعت، وفرت لنفسك خروفا واحدا.",
                       "verse":  26
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "وبين كل جموع الشعوب اقتنيت لنفسك شعبا واحدا. وهذا الشعب، الذي أحببته، أعطيته شريعة يرضى عليها الجميع.",
                       "verse":  27
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "والآن، أيها الرب، لماذا أسلمت هذا الشعب الواحد إلى كثيرين، وأهنت الأصل الواحد فوق الآخرين، وبعثرت وحيدك بين الكثيرين؟",
                       "verse":  28
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "إن الذين قاوموا مواعيدك قد داسوا الذين آمنوا بعهودك.",
                       "verse":  29
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فإن كنت حقا تبغض شعبك هكذا، فينبغي أن يعاقبوا بيدك أنت.",
                       "verse":  30
                   }
               ]
}
