    "verses":  [
                   {
                       "chapter":  3,
                       "text_ar":  "ولكنك تركت واحدا منهم، نوحا مع أهل بيته، وكل الأبرار الذين تناسلوا منه.",
                       "verse":  11
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "وحدث أنه عندما بدأ الذين عاشوا على الأرض في التكاثر، أكثروا أيضا الأولاد والشعوب والأمم الكثيرة، وبدأوا مرة أخرى يصيرون أكثر فجورا من آبائهم.",
                       "verse":  12
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "وحدث عندما صنعوا الشر قدامك، اخترت واحدا من بينهم، كان اسمه إبراهيم.",
                       "verse":  13
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "أحببته، وله وحده أظهرت نهاية الأوقات سرا بالليل،",
                       "verse":  14
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "وصنعت معه عهدا أبديا، واعدا إياه أنك لن تترك نسله أبدا. وله أعطيت إسحاق، ولإسحاق أعطيت يعقوب وعيسو.",
                       "verse":  15
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "وأفرزت يعقوب لنفسك، ورفضت عيسو. فصار يعقوب جماعة عظيمة.",
                       "verse":  16
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "وحدث عندما أخرجت نسله من مصر، صعدت بهم إلى جبل سيناء.",
                       "verse":  17
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "وطأطأت السماوات أيضا، وزلزلت الأرض، وحركت العالم كله، وجعلت الأعماق ترتعد، وأزعجت الدهر.",
                       "verse":  18
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "واجتاز مجدك عبر أربعة أبواب: من نار، وزلزلة، وريح، وجليد، لكي تعطي الشريعة لنسل يعقوب، والوصية لنسل إسرائيل.",
                       "verse":  19
                   },
                   {
                       "chapter":  3,
                       "text_ar":  "ومع ذلك لم تنزع منهم قلبهم الشرير، لكي تثمر شريعتك فيهم.",
                       "verse":  20
                   }
               ]
}
