    "verses":  [
                   {
                       "chapter":  9,
                       "text_ar":  "فَانْظُرْ، إِنِّي زَرَعْتُ شَرِيعَتِي فِيكُم، فَسَتُـثْمِرُ فِيكُم، وَتَتَمَجَّدُونَ فِيهَا إِلَى الأَبَدِ.",
                       "verse":  31
                   },
                   {
                       "chapter":  9,
                       "text_ar":  "وَأَسْلافُنَا الَّذِينَ قَبِلُوا الشَّرِيعَةَ لَمْ يَحْفَظُوهَا، وَلَا أَحَلُّوا الأَحْكَامَ. وَمَا هَلَكَ ثَمَرُ الشَّرِيعَةِ، لأَنَّهَا لَمْ تَسْتَطِعْ ذَلِكَ، لِأَنَّهَا كَانَتْ لَكُمْ.",
                       "verse":  32
                   },
                   {
                       "chapter":  9,
                       "text_ar":  "وَمَا هَلَكَ الَّذِينَ قَبِلُوهَا، لأَنَّهُمْ لَمْ يَحْفَظُوا مَا زُرِعَ فِيهِمْ.",
                       "verse":  33
                   },
                   {
                       "chapter":  9,
                       "text_ar":  "فَانْظُرْ، إِنَّهُ طَرِيقٌ عِنْدَمَا تَسْتَقْبِلُ الأَرْضُ الْبِذْرَ، أَوِ الْبَحْرُ سَفِينَةً، أَوْ أَيَّ مِيضَةٍ طَعَامًا أَوْ شَرَابًا، وَإِذَا حَصَلَ أَنْ مَا زُرِعَ، أَوْ مَا أُقِيمَ،",
                       "verse":  34
                   },
                   {
                       "chapter":  9,
                       "text_ar":  "أَوِ الأَشْيَاءُ الَّتِي قُبِلَتْ تَنْتَهِي، فَتَنْتَهِي هَذِهِ، لَكِنَّ الأِمْعَاءَ تَبْقَى. عِنْدَنَا لاَ يَحْدُثُ ذَلِكَ.",
                       "verse":  35
                   },
                   {
                       "chapter":  9,
                       "text_ar":  "لأَنَّاتُنَا الَّذِينَ قَبِلْنَا الشَّرِيعَةَ نَهْلِكُ بِالْخَطِيَّةِ، مَعَ قَلْبِنَا الَّذِي قَبِلَهَا.",
                       "verse":  36
                   },
                   {
                       "chapter":  9,
                       "text_ar":  "وَلَكِنْ الشَّرِيعَةَ لاَ تَهْلِكُ، بَلْ تَبْقَى فِي مَجْدِهَا.",
                       "verse":  37
                   },
                   {
                       "chapter":  9,
                       "text_ar":  "لَمَّا نَطَقْتُ بِهَذِهِ الأُمُورِ فِي قَلْبِي، اطَّلَعْتُ بَعَيْنِي، وَرَأَيْتُ عَنِ يَمِينِي امْرَأَةً، وَإِذَا هِيَ هَائِمَةٌ، وَتَبْكِي بِصَوْتٍ عَظِيمٍ، وَفُضُلَتْ فِي نَفْسِهَا. سُودَ ثِيَابُهَا، وَعَلَى رَأْسِهَا رَمَادٌ.",
                       "verse":  38
                   },
                   {
                       "chapter":  9,
                       "text_ar":  "ثُمَّ أَرَحْتُ أَفْكَارِي فِي شُغْلِي، وَأَقْبَلْتُ إِلَيْهَا،",
                       "verse":  39
                   },
                   {
                       "chapter":  9,
                       "text_ar":  " وَقُلْتُ لَهَا: «لِمَاذَا تَبْكِينَ؟ لِمَاذَا فَضِلْتِ فِي نَفْسِكِ؟»",
                       "verse":  40
                   }
               ]
}
