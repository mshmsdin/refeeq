    "verses":  [
                   {
                       "chapter":  7,
                       "text_ar":  "لأجلهم صنعت الدهر، وأما ما حدث بعد ذلك فقد قضي به عندما خالف آدم فرائضي.",
                       "verse":  11
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "حينئذ صارت مداخل هذا الدهر ضيقة ومحزنة ومتعبة، وقليلة وشريرة، ومليئة بالأخطار، ومكتنفة بأتعاب عظيمة.",
                       "verse":  12
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "وأما مداخل الدهر الأعظم فواسعة وآمنة وتثمر ثمر الخلود.",
                       "verse":  13
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "فإن لم يدخل الأحياء في هذه الأمور الصعبة والباطلة، فلن يستطيعوا أن ينالوا ما قد أعد لهم.",
                       "verse":  14
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "والآن فلماذا تضطرب إذ أنت إنسان فاسد؟ ولماذا ترتجف إذ أنت مائت؟",
                       "verse":  15
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "ولماذا لم تفكر في عقلك في المستقبل بدلاً من الحاضر؟",
                       "verse":  16
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "فأجبت وقلت: أيها السيد الرب، ها إنك أمرت في شريعتك أن الأبرار يرثون هذه الأشياء، وأن الفجار يهلكون.",
                       "verse":  17
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "فالأبرار يحتملون الأمور الصعبة ويرجون السهلة، وأما الذين عملوا الإثم فقد احتملوا الأمور الصعبة ولن يروا السهلة.",
                       "verse":  18
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "فقال لي: لست أنت دياناً فوق الله، ولا لك فهم أكثر من العلي.",
                       "verse":  19
                   },
                   {
                       "chapter":  7,
                       "text_ar":  "بل ليهلك كثيرون ممن يعيشون الآن، ولا تستهان شريعة الله الموضوعة أمامهم.",
                       "verse":  20
                   }
               ]
}
