    "verses":  [
                   {
                       "chapter":  6,
                       "text_ar":  "فإن صليت أيضا الآن، وصمت سبعة أيام أخر، أعود فأخبرك بعظائم أعظم من هذه.",
                       "verse":  31
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "لأن صوتك قد سمع أمام العلي، فإن القوي قد رأى بلك، وعاين طهاراتك التي حفظتها منذ صباك.",
                       "verse":  32
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "لذلك أرسلني لأريك كل هذه، وأقول لك: آمن ولا تخف.",
                       "verse":  33
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "ولا تعجل لتعتقد بالبواطل في الأزمنة الأولى، لكيلا تعجل في الأزمنة الأخيرة.",
                       "verse":  34
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وكان بعد هذا أني بكيت أيضا، وصمت سبعة أيام هكذا، حتى أكملت الأسابيع الثلاثة التي قال لي.",
                       "verse":  35
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وفي الليلة الثامنة اضطرب قلبي في داخلي جدا، وابتدأت أتكلم أمام العلي.",
                       "verse":  36
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "لأن روحي كانت متقدة جدا، ونفسي في ضيق.",
                       "verse":  37
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "فقلت: أيها الرب، أنت حقا تكلمت في مبتدأ الخليقة في اليوم الأول، وقلت هكذا: لتصنع السماء والأرض، وأكملت كلمتك العمل.",
                       "verse":  38
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "حينئذ كان الروح يحوم، وكانت الظلمة والسكون من كل جانب، ولم يكن بعد صوت الإنسان.",
                       "verse":  39
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "حينئذ أمرت أن يخرج شعاع نور من خزائنك، لكي تظهر أعمالك حينئذ.",
                       "verse":  40
                   }
               ]
}
