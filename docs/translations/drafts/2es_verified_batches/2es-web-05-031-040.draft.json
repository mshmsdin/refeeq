    "verses":  [
                   {
                       "chapter":  5,
                       "text_ar":  "فلما كلمت بهذا الكلام، أرسل إلي الملاك الذي أتى إلي في الليلة السابقة،",
                       "verse":  31
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "وقال لي: اسمع لي فأعلمك، واصغ إلي فأخبرك بأكثر.",
                       "verse":  32
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فقلت: تكلم يا سيد. فقال لي: إنك مضطرب البال جداً من أجل إسرائيل. أتحب ذلك الشعب أكثر من الذي صنعه؟",
                       "verse":  33
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فقلت: لا يا سيد، بل قد تكلمت من شدة الحزن، لأن قلبي في عذاب كل ساعة وأنا أجاهد لأدرك طريق العلي وأفحص عن جزء من قضائه.",
                       "verse":  34
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فقال لي: لا تستطيع. فقلت: ولماذا يا سيد؟ ولماذا ولدت؟ ولم لا يكن رحم أمي قبري حتى لا أرى تعب يعقوب وتعب شعب إسرائيل المضني؟",
                       "verse":  35
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فقال لي: عد لي الذين لم يأتوا بعد. واجمع لي القطرات المشتتة، وأعِد الأزهار اليابسة خضراء من أجلي.",
                       "verse":  36
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "وافتح لي المخادع المغلقة، وأخرج لي الرياح المحبوسة فيها. أو أرني صورة صوت. فحينئذ أخبرك بالتعب الذي سألت أن تراه.",
                       "verse":  37
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فقلت: أيها السيد الرب، من يقدر أن يعرف هذه الأشياء إلا من ليس له مسكن مع البشر؟",
                       "verse":  38
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "أما أنا فمعوز الحكمة. فكيف إذن أتكلم في هذه الأشياء التي سألتني عنها؟",
                       "verse":  39
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فقال لي: كما أنك لا تستطيع أن تفعل شيئاً من هذه الأشياء التي تكلمت عنها، هكذا لا تستطيع أن تكتشف قضائي، ولا نهاية المحبة التي وعدت بها شعبي.",
                       "verse":  40
                   }
               ]
}
