    "verses":  [
                   {
                       "chapter":  12,
                       "text_ar":  "وحدث بينما كان الأسد يتكلم بهذه الكلمات إلى النسر، أنني رأيت،",
                       "verse":  1
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "وهوذا الرأس الذي بقي قد اختفى، والجناحان اللذان عبرا إليه قاما ونصبا نفسيهما ليملكا، وكانت مملكتهما قصيرة ومليئة بالصخب.",
                       "verse":  2
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "رأيت وهوذا هما قد اختفيا، وأحرق جسد النسر كله حتى صارت الأرض في خوف شديد. ثم استيقظت بسبب ارتباك الذهن العظيم والخوف الشديد، وقلت لروحي:",
                       "verse":  3
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "هوذا أنت فعلت بي هذا، لأنك تفحصين طرق العلي.",
                       "verse":  4
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "هوذا ما زلت متعبا في ذهني، وضعيقا جدا في روحي، وليس في حتى القليل من القوة، بسبب الخوف الشديد الذي ارتعبت به الليلة.",
                       "verse":  5
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "لذلك سأطلب الآن من العلي أن يقويني إلى النهاية.",
                       "verse":  6
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "ثم قلت: أيها السيد السيادة، إن كنت قد وجدت نعمة في عينيك، وإن كنت مبررا معك أكثر من كثيرين غيرهم، وإن كانت صلاتي قد صعدت حقا أمام وجهك،",
                       "verse":  7
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "فقوني إذن، وأرني أنا عبدك، تفسير ومعنى هذه الرؤيا المخيفة، لكي تعزي نفسي تماما.",
                       "verse":  8
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "لأنك حسبتني أهلا لأن تريني نهاية الزمان وأحداث الأزمنة الأخيرة.",
                       "verse":  9
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "فقال لي: هذا هو تفسير هذه الرؤيا التي رأيتها:",
                       "verse":  10
                   }
               ]
}
