    "verses":  [
                   {
                       "chapter":  12,
                       "text_ar":  "بماذا أخطأنا إليك، وأي شر عملناه ضدك حتى تتركنا هكذا تماماً وتجلس في هذا الموضع؟",
                       "verse":  41
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "لأنه من بين جميع الأنبياء، لم يبقَ لنا سواك، كعنقود قطاف، وكراج في موضع مظلم، وكملجأ لسفينة نجت من العاصفة.",
                       "verse":  42
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "أليست الشرور التي حلت بنا كافية؟",
                       "verse":  43
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "إن تخليت عنا، فكم كان ذلك أفضل لنا لو كنا نحن أيضاً قد فنينا في حريق صيون!",
                       "verse":  44
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "لأننا لست أفضل من أولئك الذين ماتوا هناك. ثم بكوا بصوت عالٍ، فأجبتهم:",
                       "verse":  45
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "تشجعوا يا إسرائيل! لا تحزنوا يا بيت يعقوب؛",
                       "verse":  46
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "فإن العلي يذكركم. والقدير لم ينسكم إلى الأبد.",
                       "verse":  47
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "أما أنا فما تخلت عنكم، ولم أبتعد عنكم؛ بل أتيت إلى هذا الموضع لأصلي من أجل خراب صيون، ولكي أطلب الرحمة لذل مقدسك.",
                       "verse":  48
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "فالآن اذهبوا كل واحد إلى بيته، وبعد هذه الأيام سآتي إليكم.",
                       "verse":  49
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "فذهب الشعب في طريقهم إلى المدينة كما قلت لهم.",
                       "verse":  50
                   }
               ]
}
