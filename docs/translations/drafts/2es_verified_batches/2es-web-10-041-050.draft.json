    "verses":  [
                   {
                       "chapter":  10,
                       "text_ar":  "المرأة التي ظهرت لك قبل قليل، التي رأيتها تنوح وبدأت تعزيها،",
                       "verse":  41
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "ولكن الآن لا ترى شبه المرأة بعد، بل ظهرت لك مدينة قيد البناء،",
                       "verse":  42
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "وهي أخبرتك بموت ابنها، فهذا هو التفسير:",
                       "verse":  43
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "هذه المرأة التي رأيتها هي صيون التي تراها الآن كمدينة تُبنى.",
                       "verse":  44
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "أخبرتك أنها كانت عاقراً لمدة ثلاثين سنة لأنه كانت هناك ثلاثة آلاف سنة في العالم لم يُقدم فيها تقدمة بعد.",
                       "verse":  45
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "وحدث بعد ثلاثة آلاف سنة أن سليمان بنى المدينة وقدم التقادم. وعندئذ ولدت العاقر ابناً.",
                       "verse":  46
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "أخبرتك أنها ربته بعناية فائقة. وكان ذلك هو المسكن في أورشليم.",
                       "verse":  47
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "وحين قالت لك إن ابني مات حين دخل حجرة عرسه، وأصابتها تلك المصيبة، فهذا هو الدمار الذي حل بأورشليم.",
                       "verse":  48
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "هوذا قد رأيت شبهها كيف ناحت على ابنها، وبدأت تعزيها عما حدث لها. هذه هي الأمور التي كان ينبغي أن تُكشف لك.",
                       "verse":  49
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "لأن العلي الآن، إذ يرى أنك حزين بإخلاص وتتألم من كل قلبك من أجلها، قد أراكم بهاء مجدها وجمال حسنها.",
                       "verse":  50
                   }
               ]
}
