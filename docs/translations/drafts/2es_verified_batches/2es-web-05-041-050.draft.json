    "verses":  [
                   {
                       "chapter":  5,
                       "text_ar":  "قُلْتُ: «لَكِنِ يَا سَيِّدِي، قَدْ عَمِلْتَ الوَعْدَ لِلْمَوْجُودِينَ فِي الْمُنْتَذِرَةِ. فَمَاذَا يَفْعَلُ الَّذِينَ كَانُوا قَبْلَنَا، أَوْ نَحْنُ حَرُونَا، أَوِ الَّذِينَ سَيَأْتُونَ بَعْدَنَا؟»",
                       "verse":  41
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "قَالَ لِي: «سَأُقَارِنُ حَدْسِي بِخَاتَمٍ. كَمَا لاَ تَكُونُ انْتِصَارَةٌ لآخرين، كَذلِكَ لاَ تَكُونُ سُرْعَةٌ لِأَوَائِلِ الْعَالَمِ.»",
                       "verse":  42
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فَأَجَبْتُ: «أَمَا قَدَرْتَ أَنْ تَجْمَعَ جَمِيعَ الدَّوَابِّ الَّتِي خُلِقَتْ، وَاجْتَمَعَتْ وَانْجُمِتْ، لِيُرِيَ قَضَائَكَ سَرِيعًا»",
                       "verse":  43
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فَأَجَابَنِي: «الرَّاعِي لاَ يَسْتَطِيعُ أَنْ يَسْعَى أَسْرَعَ مِنَ الرِّاعِي، وَلاَ يَسْتَطِيعُ أَنْ يَحْمِلَ الَّذِي خُلِقَ فِيهِ مَن سُيَخْلَقُ فِيهِ فِي وَقْتٍ وَاحِد.»",
                       "verse":  44
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فَقُلْتُ: «كَيْفَ قُلْتَ لِعَبْدِكَ: إِنَّكَ فِي حَقِيْقَةٍ تَحْيِي كُلَّ خَلْقٍ قَدْ خَلَقْتَ؟ فَالَّذِي خُلِقَ يَعِيشُ مَعَ الأَرْضِ، فَلِمَ لاَ يَسْتَطِيعُ الآنَ أَنْ يَقُومَ مَعَ الأَرْضِ؟»",
                       "verse":  45
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "وَقَالَ لِي: «اسْأَلْ رَحِمَ الْمَرْأَةِ وَقُلْ لَهَا: إِذَا حَمَلْتَ عَشَرَةً، لِمَ لاَ تُلِدِينَ كُلَّهُمْ فِي وَقْتٍ وَاحِد؟ فَاسْأَلِي الرِّحْمَ أَنْ يُخْرِجَ الْعَشَرَةَ مَعًا»",
                       "verse":  46
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فَقُلْتُ: «لاَ تَسْتَطِيْعُ، بَلْ تُنَادِرُهُمْ كُرُزًا فِي وَقْتِهِ البَدِي.»",
                       "verse":  47
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فَقَالَ لِي: «كَذَلِكَ قَدْ أَعْطَيْتُ الأَرْضَ رِجْحًا لأُوْلَئِكَ الَّذِينَ بِعْدِ الأَرْضِ، فَهُمْ يَطْلُبُوكَ فِي وَقْتِ يَطْعَمُوكَ، فَهُم يَطْلُبُونَ أَحَدًا فِي وَقْتِهِ.»",
                       "verse":  48
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "لأَنَّهُ كَمَا لاَ تَسْتَطِيْعُ الشَّبِيَّةُ أَنْ تَلِدَ، وَلاَ قَدْ شِخْتَ لأَنَّهُ لاَ تَسْتَطِيْعُ تَحْمِيلًا، كَذَلِكَ رَتَّبْتُ الأَرْضِ الَّتِي خَلَقْتُهَا.»",
                       "verse":  49
                   },
                   {
                       "chapter":  5,
                       "text_ar":  "فَقُلْتُ: «بِما أَنَّكَ ذَهَبْتَ أَوْصَلَتْ طَرِيْقِي، فَلَك عِلْمٌ قَائِمًا. أَمَّا أُمُّنَا الَّتِي كَانَتْ قايمًا مِنْكُمْ، هَلْ هِيَ شَابَّةٌ أَوْ هِيَ فِي الاوْمَالْ.»",
                       "verse":  50
                   }
               ]
