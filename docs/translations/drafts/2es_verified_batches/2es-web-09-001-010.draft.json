    "verses":  [
                   {
                       "chapter":  9,
                       "verse":  1,
                       "text_ar":  "أجابني، \"قِسْمِيهِ بعناية في داخلك. عندما ترى أن جزءًا معينًا من العلامات قد مر، والتي أخبرك بها من قبل،\""
                   },
                   {
                       "chapter":  9,
                       "verse":  2,
                       "text_ar":  "ثم ستفهم أنه هو الوقت الحقيقي الذي سيزور فيه العليّ العالم الذي خلقه."
                   },
                   {
                       "chapter":  9,
                       "verse":  3,
                       "text_ar":  "عندما تُرى الزلازل، والضوضاء بين الأمم، وخطط الدول، ودوام القادة، والارتباك بين الملوك في العالم،"
                   },
                   {
                       "chapter":  9,
                       "verse":  4,
                       "text_ar":  "ستفهم أن العليّ تحدث عن هذه الأشياء منذ أيام قديمة، من البداية."
                   },
                   {
                       "chapter":  9,
                       "verse":  5,
                       "text_ar":  "فكما هو مع كل ما يُصنع في العالم، البداية واضحة والنهاية واضحة،"
                   },
                   {
                       "chapter":  9,
                       "verse":  6,
                       "text_ar":  "كذلك أوقات العليّ: البداية واضحة في العجائب والأعمال العظيمة، والنهاية في الآثار والعلامات."
                   },
                   {
                       "chapter":  9,
                       "verse":  7,
                       "text_ar":  "كل من سيُنجَى، وسينجوّ من أعماله، أو بالإيمان الذي آمن به،"
                   },
                   {
                       "chapter":  9,
                       "verse":  8,
                       "text_ar":  "سيُحفظ من هذه الأذى، وسيرى خلاصه في أرضي وأطرافها التي قد أقدسها لنفسي منذ البداية."
                   },
                   {
                       "chapter":  9,
                       "verse":  9,
                       "text_ar":  "ثم سيُصدم أولئك الذين يسيئون طرقي الآن. أولئك الذين هجموا عليهم بغير حق سيعيشون في عذاب."
                   },
                   {
                       "chapter":  9,
                       "verse":  10,
                       "text_ar":  "لأن كثيرًا ممن في حياتهم قد تلقوا الفوائد، ومع ذلك لم يعرفوا بي."
                   }
               ]
}
