    "verses":  [
                   {
                       "chapter":  12,
                       "text_ar":  "النَسْرُ الَّذِي رَأَيْتَهُ طَالِعاً مِنَ الْبَحْرِ هُوَ الْمَمْلَكَةُ الرَّابِعَةُ الَّتِي ظَهَرَتْ فِي رُؤْيَا لأَخِيكَ دَانِيَالَ.",
                       "verse":  11
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "وَلَكِنَّهُ لَمْ يُفَسَّرْ لَهُ، كَمَا أُفَسِّرُهُ الآنَ لَكَ أَوْ فَسَّرْتُهُ.",
                       "verse":  12
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "هُوَذَا الأَيَّامُ آتِيَةٌ لِتَقُومَ مَمْلَكَةٌ عَلَى الأَرْضِ، وَسَتَكُونُ مَهِيبَةً أَكْثَرَ مِنْ جَمِيعِ المَمَالِكِ الَّتِي سَبَقَتْهَا.",
                       "verse":  13
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "سَيَمْلِكُ فِيهَا اثْنَا عَشَرَ مَلِكاً، وَاحِداً بَعْدَ وَاحِدٍ.",
                       "verse":  14
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "وَمِنْ بَيْنِ هَؤُلاءِ، سَيَبْدَأُ الثَّانِي فِي الْمُلْكِ، وَسَيَمْلِكُ وَقْتاً أَطْوَلَ مِنْ بَقِيَّةِ الاثْنَيْ عَشَرَ.",
                       "verse":  15
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "هَذَا هُوَ تَفْسِيرُ الأَجْنِحَةِ الاثْنَيْ عَشَرَ الَّتِي رَأَيْتَهَا.",
                       "verse":  16
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "وَأَمَّا بِشَأْنِ الصَّوْتِ الَّذِي سَمِعْتَهُ يَتَكَلَّمُ، لَا خَارِجاً مِنَ الرُّؤُوسِ بَلْ مِنْ وَسَطِ جِسْمِهَا، فَهَذَا هُوَ التَّفْسِيرُ:",
                       "verse":  17
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "أَنَّهُ بَعْدَ وَقْتِ تِلْكَ الْمَمْلَكَةِ، سَتَقُومُ مُنَازَعَاتٌ لَيْسَتْ بِقَلِيلَةٍ، وَسَتَكُونُ فِي خَطَرِ السُّقُوطِ. وَمَعَ ذَلِكَ، لَنْ تَسْقُطَ حِينَئِذٍ، بَلْ سَتُسْتَرَدُّ مَرَّةً أُخْرَى إِلَى قُوَّتِهَا السَّابِقَةِ.",
                       "verse":  18
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "رَأَيْتَ الأَجْنِحَةَ الثَّمَانِيَةَ التَّحْتِيَّةَ المُلْتَصِقَةَ بِأَجْنِحَتِهَا. هَذَا هُوَ التَّفْسِيرُ:",
                       "verse":  19
                   },
                   {
                       "chapter":  12,
                       "text_ar":  "أَنَّهُ سَيَقُومُ فِيهَا ثَمَانِيَةُ مُلُوكٍ، تَكُونُ أَوْقَاتُهُمْ قَصِيرَةً وَسِنُوهُمْ سَرِيعَةً.",
                       "verse":  20
                   }
               ]
