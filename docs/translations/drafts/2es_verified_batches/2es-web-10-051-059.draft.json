                       "chapter":  10,
                       "text_ar":  "لذلك طلبت منك أن تبقى في الحقل حيث لم يُبنَ بيت،",
                       "verse":  51
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "لأني كنت أعلم أن العلي سيظهر لك هذا.",
                       "verse":  52
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "لذلك أمرتك أن تأتي إلى الحقل، حيث لم يكن أساس لأي بناء.",
                       "verse":  53
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "لأنه لا يمكن لأي بناء بشري أن يقف في المكان الذي ستُظهر فيه مدينة العلي.",
                       "verse":  54
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "لذلك لا تخف ولا تدع قلبك يرتعب، بل امض في طريقك وانظر جمال وبناء العظمة، بقدر ما تستطيع عيناك أن ترى.",
                       "verse":  55
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "حينئذ ستسمع بقدر ما تستطيع أذناك أن تفهما.",
                       "verse":  56
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "لأنك مبارك أكثر من كثيرين، ودُعيت باسمك لتكون مع العلي، مثل القليلين فقط.",
                       "verse":  57
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "ولكن غداً في الليل ستبقى هنا،",
                       "verse":  58
                   },
                   {
                       "chapter":  10,
                       "text_ar":  "وهكذا سيوضح لك العلي تلك الرؤى في أحلام عما سيفعله العلي بالذين يعيشون على الأرض في الأيام الأخيرة. فنمت تلك الليلة وأخرى، كما أمرني.",
                       "verse":  59
                   }
               ]
