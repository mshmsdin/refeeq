    "verses":  [
                   {
                       "chapter":  6,
                       "text_ar":  "الأطفال أبناء السنة سيتكلمون بأصواتهم. والنساء الحوامل ستلدن أطفالاً قبل الأوان في ثلاثة أو أربعة أشهر، وسيعيشون ويرقصون.",
                       "verse":  21
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "فجأة ستظهر الأماكن المزروعة كأنها غير مزروعة. والمخازن المملوءة ستوجد فجأة فارغة.",
                       "verse":  22
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "البوق سيصدر صوتاً عندما يسمعه كل إنسان، فسيخافون فجأة.",
                       "verse":  23
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "في ذلك الوقت سيشن الأصدقاء حرباً بعضهم على بعض مثل الأعداء. والأرض ستقف في خوف مع الساكنين فيها. ينابيع العيون ستقف، بحيث لا تجري لمدة ثلاث ساعات.",
                       "verse":  24
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "سيكون أنه كل من يبقى بعد كل هذه الأمور التي أخبرتك بها، فإنه سيخلص وسيرى خلاصي ونهاية عالمي.",
                       "verse":  25
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "سيرون الرجال الذين رُفعوا، الذين لم يذوقوا الموت منذ ولادتهم. قلب السكان سيتغير ويتحول إلى روح أخرى.",
                       "verse":  26
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "لأن الشر سيمحى والمكر سيُطفأ.",
                       "verse":  27
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "الإيمان سيزهر. الفساد سَيُهزم، والحق الذي ظل طويلاً بلا ثمر سيُعلن.",
                       "verse":  28
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وعندما كلمني، هوذا قليلاً قليلاً، المكان الذي وقفت عليه اهتز ذهاباً وإياباً.",
                       "verse":  29
                   },
                   {
                       "chapter":  6,
                       "text_ar":  "وقال لي: جئت لأريك هذه الأمور هذه الليلة.",
                       "verse":  30
                   }
               ]
}
