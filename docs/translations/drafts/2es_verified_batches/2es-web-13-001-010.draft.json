    "verses":  [
                   {
                       "chapter":  13,
                       "text_ar":  "وكان بعد سبعة أيام أني حلمت حلماً بالليل.",
                       "verse":  1
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "هوذا ريح هبت من البحر وحركت كل أمواجه.",
                       "verse":  2
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "رأيت وإذا بريح أصعدت من وسط البحر شبهاً لمنظر إنسان، ورأيت وإذا بذلك الإنسان طار مع سحاب السماء. وحول وجهه لينظر، وكل ما رآه ارتعد.",
                       "verse":  3
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "وكلما خرج صوت من فمه، ذاب كل من سمع صوته، كالشمع حين يذوب إذا حس بالنار.",
                       "verse":  4
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "وبعد هذا رأيت وإذا بجمهور لا يحصى من الناس مجتمع من رياح السماء الأربع ليشنوا حرباً على الإنسان الخارج من البحر.",
                       "verse":  5
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "ورأيت وإذا به نحت لنفسه جبلاً عظيماً وطار عليه.",
                       "verse":  6
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "وحاولت أن أرى الناحية أو المكان الذي نُحت منه الجبل فلم أستطع.",
                       "verse":  7
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "وبعد هذا رأيت وإذا بكل الذين اجتمعوا ليحاربوه خافوا جداً ومع ذلك تجرأوا أن يحاربوا.",
                       "verse":  8
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "وهو إذ رأى هجوم الجمهور الآتي، لم يرفع يده ولا أمسك رمحاً ولا أي سلاح حرب،",
                       "verse":  9
                   },
                   {
                       "chapter":  13,
                       "text_ar":  "بل رأيت فقط كيف أرسل من فمه شبه سيل من نار، ومن شفتيه نفخة ملتهبة، ومن لسانه أطلق عاصفة من شرر.",
                       "verse":  10
                   }
               ]
}
