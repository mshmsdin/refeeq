  "verses": [
    {
      "chapter": 11,
      "verse": 1,
      "text_ar": "وكان في الليلة الثانية أني رأيت حلماً، وإذا بنسر له اثنا عشر جناحاً ذو ريش وثلاثة رؤوس قد صعد من البحر.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 2,
      "text_ar": "ورأيت وإذا به بسط جناحيه فوق كل الأرض، وسبحت نحوه كل رياح السماء، وتجمعت السحب ضده.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 3,
      "text_ar": "ورأيت، ومن جناحيها نبتت أجنحة أخرى بجانبها، وصارت أجنحة صغيرة دقيقة.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 4,
      "text_ar": "وأما رؤوسه فكانت مستريحة. وكان الرأس الذي في الوسط أكبر من الرؤوس الأخرى، غير أنه استراح معها.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 5,
      "text_ar": "وعلاوة على ذلك رأيت، وإذا بالنسر يطير بجناحيه ليملك على الأرض وعلى الساكنين فيها.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 6,
      "text_ar": "ورأيت كيف أن كل الأشياء تحت السماء خضعت له، ولم يتكلم أحد ضده، ولا حتى مخلوق واحد على الأرض.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 7,
      "text_ar": "ورأيت وإذا بالنسر نهض على مخالبه، ورفع صوته إلى أجنحته قائلاً:",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 8,
      "text_ar": "«لا تسهروا كلكم في وقت واحد. ليرقد كل واحد في مكانه الخاص ويسهر بالتناوب؛",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 9,
      "text_ar": "وأما الرؤوس فلتُحفظ للنهاية».",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 10,
      "text_ar": "ورأيت وإذا الصوت لم يخرج من رؤوسه، بل من وسط جسده.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 11,
      "text_ar": "وأحصيت أجنحته التي كانت بالقرب من الأخرى، وإذا بها ثمانية أجنحة.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 12,
      "text_ar": "ورأيت وإذا على الجانب الأيمن قام جناح واحد وملَكَ على كل الأرض.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 13,
      "text_ar": "ولما ملَكَ جاءت نهايته فاختفى، حتى لم يعد يظهر مكانه بعد. وقام الجناح التالي وملَكَ، وحكم زمناً طويلاً.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 14,
      "text_ar": "وحدث أنه عندما ملَكَ جاءت نهايته أيضاً، فاختفى مثل الأول.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 15,
      "text_ar": "وهوذا صوت أتاه وقال:",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 16,
      "text_ar": "«اسمع، أيها الذي حكم على الأرض طوال هذا الوقت! أعلن لك هذا، قبل أن تختفي،",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 17,
      "text_ar": "لن يحكم أحد بعدك بمثل مدتك، ولا حتى بنصفها».",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 18,
      "text_ar": "ثم قام الثالث، وحكم مثل سابقيه، وهو أيضاً اختفى.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 19,
      "text_ar": "وهكذا جرى الأمر مع كل الأجنحة واحداً تلو الآخر، إذ حكم كل واحد ثم اختفى.",
      "review_notes_ar": []
    },
    {
      "chapter": 11,
      "verse": 20,
      "text_ar": "ورأيت وإذا بمرور الوقت أقيمت الأجنحة التي تلتها على الجانب الأيمن لكي تحكم هي أيضاً. وحكم بعضها، ولكنها في غضون وقت قصير اختفت.",
      "review_notes_ar": []
    }
  ]
}
