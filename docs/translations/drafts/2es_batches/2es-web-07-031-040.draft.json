  "verses": [
    {
      "chapter": 7,
      "verse": 31,
      "text_ar": "وبعد سبعة أيام سيُقام العالم الذي لم يُستيقظ بعد، ويموت ما هو قابل للفساد.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 32,
      "text_ar": "وسترد الأرض الراقدين فيها، والتراب الساكنين فيه في سكوت، وستُسلم الأماكن الخفية الأنفس التي استودعت فيها.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 33,
      "text_ar": "ويُعلن العلي على كرسي الدينونة، وتزول الرأفة، وتُسحب الأناة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 34,
      "text_ar": "ولا يبقى إلا الدينونة، وتقف الحق، وتشتد الإيمان.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 35,
      "text_ar": "ويتبع ذلك الجزاء، ويُظهر الأجر، وتستيقظ الأعمال الصالحة، ولا تنام الأعمال الشريرة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 36,
      "text_ar": "وتظهر حفرة العذاب، وبجانبها يكون موضع الراحة، ويُرى أتون جهنم، وبجانبه فردوس النعيم.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 37,
      "text_ar": "حينئذ يقول العلي للأمم المقامة من الأموات: «انظروا وافهموا مَن أنكرتم، ومَن لم تخدموا، ومَن احتقرتم وصاياه.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 38,
      "text_ar": "انظروا إلى هذا الجانب وإذاك، ههنا النعيم والراحة، وهناك النار والعذابات». هكذا يخاطبهم في يوم الدينونة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 39,
      "text_ar": "هذا يوم ليس له شمس ولا قمر ولا كواكب،",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 40,
      "text_ar": "ولا سحاب ولا رعد ولا برق ولا ريح ولا ماء ولا هواء ولا ظلام ولا مساء ولا صباح،",
      "review_notes_ar": []
    }
  ]
}
