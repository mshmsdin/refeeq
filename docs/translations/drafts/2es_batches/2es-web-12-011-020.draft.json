  "verses": [
    {
      "chapter": 12,
      "verse": 11,
      "text_ar": "أما النسر الذي رأيته طالعاً من البحر، فهو المملكة الرابعة التي ظهرت في رؤيا لأخيك دانيال.",
      "review_notes_ar": []
    },
    {
      "chapter": 12,
      "verse": 12,
      "text_ar": "ولكنها لم تُفسر له، كما أفسرها أنا لك الآن أو كما فسرتها.",
      "review_notes_ar": []
    },
    {
      "chapter": 12,
      "verse": 13,
      "text_ar": "هوَذا الأيام آتية لتقوم مملكة على الأرض، وستكون مهوبة أكثر من جميع الممالك التي كانت قبلها.",
      "review_notes_ar": []
    },
    {
      "chapter": 12,
      "verse": 14,
      "text_ar": "وسيملك فيها اثنا عشر ملكاً، الواحد بعد الآخر.",
      "review_notes_ar": []
    },
    {
      "chapter": 12,
      "verse": 15,
      "text_ar": "ومن بين هؤلاء، يبدأ الثاني في الملك، وسيملك مدة أطول من باقي الاثني عشر.",
      "review_notes_ar": []
    },
    {
      "chapter": 12,
      "verse": 16,
      "text_ar": "هذا هو تفسير الأجنحة الاثني عشر التي رأيتها.",
      "review_notes_ar": []
    },
    {
      "chapter": 12,
      "verse": 17,
      "text_ar": "وأما متى سمعت صوتاً يتكلم، لا يصدر عن الرؤوس، بل من وسط جسدها، فهذا هو تفسيره:",
      "review_notes_ar": []
    },
    {
      "chapter": 12,
      "verse": 18,
      "text_ar": "أنه بعد زمان تلك المملكة، ستحدث منازعات ليست قليلة، وستكون في خطر السقوط. ومع ذلك، فلن تسقط حينئذ، بل ستُستعاد مرة أخرى إلى قوتها السابقة.",
      "review_notes_ar": []
    },
    {
      "chapter": 12,
      "verse": 19,
      "text_ar": "ورأيت الأجنحة الثمانية التحتية الملتصقة بأجنحتها. هذا هو تفسيره:",
      "review_notes_ar": []
    },
    {
      "chapter": 12,
      "verse": 20,
      "text_ar": "أنه سيقوم فيها ثمانية ملوك، تكون أوقاتهم قصيرة وسنواتهم سريعة.",
      "review_notes_ar": []
    }
  ]
}
