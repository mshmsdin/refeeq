  "verses": [
    {
      "chapter": 9,
      "verse": 21,
      "text_ar": "رأيتُ ونجوتُهم، لكن ليس كثيرًا، وأنقذتُ عنبًا من عنقود، ونبتةً من غابةٍ عظيمة.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 22,
      "text_ar": "فلتهلك الجموع إذن، التي وُلدت عبثًا. فليُحفظ عنبي، ونبتي، فقد أكملتُهما بعملٍ شاقٍ.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 23,
      "text_ar": "ومع ذلك، إذا انتظرت سبعة أيام أخرى—لكن لا تصوم فيها،",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 24,
      "text_ar": "وإنّك إلى حقلٍ من الزهور، حيث لا يُبنى بيت، وتتناول فقط زهور الحقل، ولا تشرب لحمًا ولا نبيذًا، بل تأكل الزهور فقط—",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 25,
      "text_ar": "وتصلي إلى العليّ باستمرار، حينئذٍ آتي وأتحدث معك.”",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 26,
      "text_ar": "فذهبت بطريقي، كما أمرني، إلى الحقل المسمى أرضة. جلست هناك بين الزهور، وأكلت من أعشاب الحقل، وهذا الطعام أَرضاني.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 27,
      "text_ar": "بعد سبعة أيام سجدت على العشب، وانقلب قلبي مرةً أخرى، كما كان من قبل.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 28,
      "text_ar": "فتُح فمي، وبدأت أتكلم أمام الرب العليّ، وقالتُ،",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 29,
      "text_ar": "«يا رب، أظهرتَ نفسك بيننا، لآبائنا في البرية، حين خرجوا من مصر، وعندما دخلوا البرية، حيث لا يمشي أحد ولا تحمل ثمرًا».",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 30,
      "text_ar": "قلتَ: «اسمعني يا إسرائيل. أنصت لكلماتى يا نسل يعقوب».",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 31,
      "text_ar": "«لأنني أزرع شريعتي فيكم، وستجلب لكم ثمرًا، وتُمجّدون بها إلى الأبد».",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 32,
      "text_ar": "لكن آباؤنا الذين تلقوا الشريعة لم يحافظوا عليها، ولم يلتزموا بالأنظمة. فثمر الشريعة لم يهلك، لأنه لم يستطع، لأنه لكم».",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 33,
      "text_ar": "ومع ذلك هلك الذين تلقوه، لأنهم لم يحافظوا على ما زرع فيهم.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 34,
      "text_ar": "هوى أن الأرض إذا استقبلت البذرة، أو البحر سفينة، أو أي وعاء طعامًا أو شرابًا، وعند حدوث ما زُرع أو ما أُطلق،",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 35,
      "text_ar": "أو الأشياء التي استُقبلت، يجب أن تنتهي، فتنتهي هذه، لكن الأوعية تبقى. ومعنا، لا يحدث ذلك هكذا.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 36,
      "text_ar": "لأننا الذين تلقينا الشريعة سنهلك بالخطية، مع قلوبنا التي استقبلتها.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 37,
      "text_ar": "ومع ذلك لا تهلك الشريعة، بل تبقى في شرفها».",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 38,
      "text_ar": "عندما قلتُ هذه الأمور في قلبي، نظرتُ حولي بعيني، وعلى يميني رأيت امرأة، وكانت تبكي وتنوح بصوت عالٍ، وكانت حزينة جدًا في ذهنها. ملابسها ممزقة، وكان عليها رماد على رأسها.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 39,
      "text_ar": "ثم تركت أفكاري التي شغلتني، وتحولتُ إليها،",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 40,
      "text_ar": "وقلتُ لها: «لماذا تبكين؟ لماذا حزنتِ في ذهنك؟»",
      "review_notes_ar": []
    }
  ]
}
