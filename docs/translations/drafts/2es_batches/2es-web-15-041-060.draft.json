  "verses": [
    {
      "chapter": 15,
      "verse": 41,
      "text_ar": "ناراً وبَرَداً وسُيوفاً طائرةً ومياهاً كثيرةً، لكي تمتثل كل السهول، وكل الأنهار، بوفرة تلك المياه.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 42,
      "text_ar": "سيهدمون المدن والأسوار، الجبال والتلول، أشجار الغابة، وعشب المروج، وغلاتها.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 43,
      "text_ar": "سيمضون بخطى ثابتة نحو بابل ويدمرونها.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 44,
      "text_ar": "سيأتون إليها ويحاصرونها، ويسكبون عليها العاصفة وكل الغضب، وحينئذ يصعد الغبار والدخان إلى السماء، وكل من حولها ينوحون عليها.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 45,
      "text_ar": "والذين يبقون سيخدمون أولئك الذين دمروها.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 46,
      "text_ar": "أيتها الآسيا، يا من تشاركين في جمال بابل، وفي مجد بهائها —",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 47,
      "text_ar": "ويل لك أيتها الشقية، لأنك جعلت نفسِك مثلها، وزيّنت بناتك للزنى لكي يُرضين ويفتخرن بمحبيك الذين اشتهوك دائماً!",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 48,
      "text_ar": "لقد اتبعتِ تلك البغيضة في كل أعمالها ومخترعاتها؛ ولذلك يقول الرب:",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 49,
      "text_ar": "«سأرسل عليك شروراً: أرملةً، وفقراً، ومجاعةً، وسيفاً، ووباءً، لتخريب بيوتك وتسليمك للدمار والموت.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 50,
      "text_ar": "ومجد قوتك سيجف كزهرة حين ترتفع الحرارة المرسلة عليك.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 51,
      "text_ar": "ستضعفين كامرأة مسكينة مضروبة ومجروحة، حتى لا تستطيعي استقبال عظمائك ومحبيك.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 52,
      "text_ar": "أكنتُ أتعامل معك بمثل هذه الغيرة»، يقول الرب،",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 53,
      "text_ar": "«لو لم تقتلي دائماً مختاريّ، متبجحة ومصفقة بيديك، ومتحدثةً عن موتاهم وأنت سكرانة؟",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 54,
      "text_ar": "جمّلي وجهك!",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 55,
      "text_ar": "أجرة الزانية ستكون في حضنك، ولذلك ستجازين.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 56,
      "text_ar": "وكما ستفعلين بمختاريّ»، يقول الرب، «هكذا يفعل بك الله ويسلمك إلى أعدائك.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 57,
      "text_ar": "أولادك سيحوتون جوعاً، وتسقطين بالسيف، وتهدم مدنك، ويهلك كل شعبك في الحقول بالسيف.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 58,
      "text_ar": "والذين في الجبال سيموتون جوعاً، ويأكلون لحم أنفسهم ويشربون دم أنفسهم، بسبب الجوع إلى الخبز والعطش إلى الماء.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 59,
      "text_ar": "وأنت، الشقية فوق الجميع، ستأتين وتقبلين الشرور مرة أخرى.",
      "review_notes_ar": []
    },
    {
      "chapter": 15,
      "verse": 60,
      "text_ar": "في العبور، سيقحمون على المدينه البغيضة ويهدمون جزءاً من أرضك، ويشوهون قسماً من مجدك، ثم يعودون ثانية إلى بابل التي دُمرت.",
      "review_notes_ar": []
    }
  ]
}
