  "verses": [
    {
      "chapter": 7,
      "verse": 121,
      "text_ar": "وأنه توجد مساكن معدة للصحة والسلامة، بينما عشنا نحن بشرور؟",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 122,
      "text_ar": "وأنه مجد العلي سيدافع عن أولئك الذين سلكوا حياة نقية، بينما سلكنا نحن في أشّر الطرق على الإطلاق؟",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 123,
      "text_ar": "وأنه ستُكشف فردوسٌ ثمرها يدوم بلا فساد، وفيه وفرة وشفاء، بينما لن ندخل نحن إليه،",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 124,
      "text_ar": "لأننا عشنا في طرق معوجة؟",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 125,
      "text_ar": "وأنه وجوه الذين مارسوا ضبط النفس ستشرق أكثر من النجوم، بينما وجوهنا ستكون أظلم من الظلام؟",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 126,
      "text_ar": "لأننا بينما كنا نعيش ونرتكب الإثم، لم نفكر فيما سيتعين علينا أن نعانيه بعد الموت.»",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 127,
      "text_ar": "فأجاب قائلاً: «هذا هو مغزى المعركة التي سيخوضها البشر المولودون على الأرض:",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 128,
      "text_ar": "إن غُلبوا فسيعانون مثلما قلتَ، وإن انتصروا فسينيالون ما أقوله.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 129,
      "text_ar": "لأن هذه هي الطريقة التي تحدث بها موسى إلى الشعب حين كان حياً، قائلاً: \"اختاروا الحياة لكي تحيا!\"",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 130,
      "text_ar": "ومع ذلك لم يصدقوه ولا الأنبياء من بعده، ولا حتى أنا الذي كلمتهم.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 131,
      "text_ar": "لذلك لن تكون هناك حزونة في هلاكهم، مثلما سيكون هناك فرح بالذين تيقنوا من الخلاص.»",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 132,
      "text_ar": "فأجبتُ وقلتُ: «أعرف يا رب أن العلي يُדعى الآن رحيماً، لكونه يرحم أولئك الذين لم يأتوا بعد إلى العالم؛",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 133,
      "text_ar": "وَرؤوفاً، لكونه يرأف بأولئك الذين يرجعون إلى شريعته؛",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 134,
      "text_ar": "وطويلي الأناة، لكونه يتأنى على الذين أخطأوا، بما أنهم مخاليقه؛",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 135,
      "text_ar": "وكريماً، لكونه مستعداً للعطاء بدلاً من أن يأخذ؛",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 136,
      "text_ar": "وغزير الرحمة، لكونه يضاعف شيئاً فشيئاً المراحم على الموجودين الآن، وعلى الذين مضوا، وأيضاً على الذين سيأتون—",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 137,
      "text_ar": "لأنه لو لم يكن رحيماً لما استمر العالم مع الساكنين فيه—",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 138,
      "text_ar": "وغافراً، لأنه لو لم يغفر من صلاحه لكي يستريح مرتكبو الآثام منها، لما بقي حيّاً حتى واحد من عشرة آلاف جزء من الجنس البشري؛",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 139,
      "text_ar": "وديّاناً، لأنه لو لم يعفُ عن الذين خُلِقوا بكلمته، ويمحُ كثرة الخطايا،",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 140,
      "text_ar": "لربما بقي قليلون جداً من جموع لا تُحصى.»",
      "review_notes_ar": []
    }
  ]
}
