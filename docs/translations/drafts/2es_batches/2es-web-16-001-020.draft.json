  "verses": [
    {
      "chapter": 16,
      "verse": 1,
      "text_ar": "الويل لكِ يا بابل ويا آسيا! الوويل لكِ يا مصر ويا سوريا!",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 2,
      "text_ar": "البسوا المسوح وثياب شعر المعزى، وولولوا على أولادكم وانوحوا، فإن هلاككم قريب.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 3,
      "text_ar": "أُرسل عليكم سيف، فمن ذا الذي يرده؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 4,
      "text_ar": "أُرسلت عليكم نار، فمن ذا الذي يطفئها؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 5,
      "text_ar": "أُرسلت عليكم بلايا، فمن ذا الذي يطردها؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 6,
      "text_ar": "أيمكن لأحد أن يطرد أسداً جائعاً في الغابة؟ أو أيمكن لأحد أن يطفئ ناراً في قش متى بدأت تحترق؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 7,
      "text_ar": "أيمكن لأحد أن يرد سهماً أطلقه رامي قوي؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 8,
      "text_ar": "الرب الإله هو الذي يرسل البلايا، فمن يطردها؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 9,
      "text_ar": "ستخرج نار من غضبه، فمن يستطيع إطفاءها؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 10,
      "text_ar": "يُبرق بروقاً، فمن لا يخاف؟ يُرعد، فمن لا يرتعد؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 11,
      "text_ar": "يهدد الرب، فمن لا يتتحطم تماماً أمام حضرته؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 12,
      "text_ar": "تتزعزع الأرض وأساساتها. ويرتفع البحر بأمواج من الأعماق، وتضطرب أمواجه مع السمك الذي فيه، أمام حضور الرب وأمام مجد قدرته.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 13,
      "text_ar": "لأن يمينه التي تشد القوس قوية، وسهامه التي يطلقها حادة، ولن تخطئ عندما تبدأ في الانطلاق نحو أقاليم المسكونة.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 14,
      "text_ar": "هوذا البلايا قد أُرسلت، ولن ترجع مرة أخرى حتى تحل على الأرض.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 15,
      "text_ar": "قد أُضرمت النار ولن تُطفأ حتى تستهلك أساسات الأرض.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 16,
      "text_ar": "مثل السهم الذي يطلقه رامي جبار لا يرجع الى الوراء، هكذا أيضاً البلايا التي أُرسلت على الأرض لن ترجع مرة أخرى.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 17,
      "text_ar": "يا ويل لي! يا ويل لي! من ينجيني في تلك الأيام؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 18,
      "text_ar": "بدء الأوجاع، حين يكون مناحة عظيمة؛ وبدء الجوع، والكثيرون يهلكون؛ وبدء الحروب، والقوات تقف في خوف؛ وبدء البلايا، والجميع يرتعدون! ماذا يفعلون عندما تأتي البلايا؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 19,
      "text_ar": "هوذا جوع ووبأ، ضيق وشدة! إنها مُرسلة كأدوات تأديب للإصلاح.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 20,
      "text_ar": "ولكن مع كل هذه الأمور لن يرجعوا عن شرهم، ولا يكونون دائماً واضعين في بالهم أدوات التأديب.",
      "review_notes_ar": []
    }
  ]
}
