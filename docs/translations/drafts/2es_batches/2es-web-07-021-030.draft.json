  "verses": [
    {
      "chapter": 7,
      "verse": 21,
      "text_ar": "لأن الله أمر بدقة الذين أتوا، بل وحالما أتوا، بما يجب أن يصنعوه لكي يحيا، وما يجب أن يحفظوه ليتجنبوا العقاب.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 22,
      "text_ar": "مع ذلك، لم يطيعوه، بل تكلموا ضده وتخيلوا لأنفسهم أباطيل.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 23,
      "text_ar": "وضعوا خططاً مكارة للشر، وقالوا علاوة على ذلك عن العلي إنه غير موجود، ولم يعرفوا طرقه.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 24,
      "text_ar5": null,
      "text_ar": "احتقروا ناموسه وأنكروا عهوده. ولم يكونوا أمناء لفرائضه، ولم يتمموا أعماله.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 25,
      "text_ar": "لذلك، يا عزرا، للفارغين هي الأشياء الفارغة، وللممتلئين هي الأشياء الممتلئة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 26,
      "text_ar": "لأنه هوذا، سيأتي الزمان، ويكون، عندما تتم هذه العلامات التي أخبرتك بها من قبل، أن العروس ستظهر، بل والمدينة الخارجة، وسيُرى من هو محتجب الآن عن الأرض.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 27,
      "text_ar": "كل من ينجو من الشرور المذكورة سيبصر عجائبي.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 28,
      "text_ar": "لأن ابني يسوع سيُعلن مع الذين هم معه، والذين يبقون سيفرحون أربعمائة سنة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 29,
      "text_ar": "وبعد هذه السنوات سيموت ابني المسيح، مع كل أولئك الذين لهم نسمة الحياة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 30,
      "text_ar": "حينئذ يُرد العالم إلى السكون القديم سبعة أيام، كما في البدء الأول، حتى لا يبقى إنسان واحد.",
      "review_notes_ar": []
    }
  ]
}
