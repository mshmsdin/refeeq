  "verses": [
    {
      "chapter": 9,
      "verse": 1,
      "text_ar": "فأجابني وقال: «قسْ بدقة في نفسك؛ فحين ترى أن جزءاً معيناً من الآلام قد انقضى، والتي أُخبرت بها من قبل،",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 2,
      "text_ar": "حينئذ تفهم أنه هو الوقت عينه الذي فيه سيفتقد العلي العالم الذي صُنِع بواسطته.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 3,
      "text_ar": "فحين تُرى في العالم زلازل، وضجيج شعوب، ومؤامرات أمم، وتزعزع قادة، واضطراب رؤساء،",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 4,
      "text_ar": "حينئذ تفهم أن العلي تكلم عن هذه الأمور منذ الأيام القديمة، منذ البدء.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 5,
      "text_ar": "لأنه كما هو الحال في كل ما يُصنع في العالم، فإن البداية واضحة والنهاية ظاهرة،",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 6,
      "text_ar": "هكذا أيضاً أزمنة العلي: البدايات ظاهرة بالعجائب والأعمال العظيمة، والنهاية بالأفعال والآيات.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 7,
      "text_ar": "وكل من سيُخلَّص، ويستطيع النجاة بأعماله، أو بالإيمان الذي به آمنوا،",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 8,
      "text_ar": "سيُحفظ من الأخطار المذكورة، وسيرى خلاصي في أرضي وفي تخومي التي قدّستها لنفسي منذ البدء.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 9,
      "text_ar": "حينئذ يتعجب أولئك الذين أساءوا استخدام طرقي الآن، والذين نبذوها باحتقار سيعيشون في العذاب.",
      "review_notes_ar": []
    },
    {
      "chapter": 9,
      "verse": 10,
      "text_ar": "لأنه بقدر ما نال كثيرون من الخيرات في حياتهم، ومع ذلك لم يعرفوني،",
      "review_notes_ar": []
    }
  ]
}
