  "verses": [
    {
      "chapter": 14,
      "verse": 21,
      "text_ar": "فإن شريعتكم قد احترقت، ولذلك لا يعرف أحد الأمور التي تصنعها، ولا الأعمال التي ستُصنع.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 22,
      "text_ar": "ولكن إن كنتُ قد وجدتُ نعمةً أمامك، فأرسل إليَّ الروح القدس، وسأكتب كل ما حدث في العالم منذ البدء، وحتى الأمور التي كُتبت في شريعتك، لكي يتمكن الناس من إيجاد الطريق، ولكي يعيش أولئك الذين سيحيوْن في الأيام الأخيرة.\"",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 23,
      "text_ar": "فأجابني وقال: \"امضِ في طريقك، واجمع الشعب معاً، وقُل لهم ألا يطلبوك لمدة أربعين يوماً.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 24,
      "text_ar": "ولكن أعدَّ لنفسك ألواحاً كثيرة، وخذ معك ساريا، ودابريا، وسيليميا، وإيثانوس، وأسيئيل، وهؤلاء الخمسة مستعدون للكتابة بسرعة؛",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 25,
      "text_ar": "وتعال إلى هنا، وسأوقد سراجاً للفهم في قلبك لا ينطفئ حتى تنتهي الأمور التي ستكتبها.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 26,
      "text_ar": "وعندما تنتهي، فإن بعض الأمور ستنشرها علانية، وبعض الأمور ستسلمها سرًّا للحكماء. غداً في هذه الساعة ستشرع في الكتابة.\"",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 27,
      "text_ar": "ثم خرجتُ كما أمرني، وجمعتُ الشعب كله معاً، وقُلْتُ:",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 28,
      "text_ar": "\"اسمعوا هذه الكلمات يا إسرائيل!",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 29,
      "text_ar": "إن آباءنا في البدء كانوا غرباء في مصر، وقد نجاةً منها،",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 30,
      "text_ar": "وتلقوا شريعة الحياة التي لم يحفظوها، والتي تعديتموها أنتم أيضاً من بعدهم.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 31,
      "text_ar": "ثم أُعطيت لكم أرض صهيون ملكاً؛ لكنكم أنتم وأسلافكم عملتم الإثم، ولم تحفظوا السبل التي أمركم بها العلي.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 32,
      "text_ar": "ولأنه قاضٍ عادل، فقد أخذ منكم في الوقت المناسب ما أعطاكم إياه.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 33,
      "text_ar": "والآن أنتم هنا، وأقرباؤكم بينكم.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 34,
      "text_ar": "لذلك، إن سيطرتم على فهمكم وأدبتم قلوبكم، فستُبقون أحياء، وبعد الموت تنالون الرحمة.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 35,
      "text_ar": "فإنه بعد الموت ستأتي الدينونة، حيث نحيا مرة أخرى. وحينئذٍ تظهر أسماء الأبرار، وتُعلن أعمال الأشرار.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 36,
      "text_ar": "فللا يأتينَّ أحد إليَّ الآن، ولا يطلبني لمدة أربعين يوماً.\"",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 37,
      "text_ar": "فأخذتُ الرجال الخمسة كما أمرني، وخرجنا إلى الحقل وبقينا هناك.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 38,
      "text_ar": "وحدث في اليوم التالي أن صوتاً ناداني قائلاً: \"يا عزرا، افتح فك واشرب ما أسقيك إياه.\"",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 39,
      "text_ar": "فتحتُ فمي، وإذا بكأس ممتلئة تُناول لي. وكانت مملوءة شيئاً شبيهًا بالماء، لكن لونها كان كالنار.",
      "review_notes_ar": []
    },
    {
      "chapter": 14,
      "verse": 40,
      "text_ar": "فأخذتُها وشربتُ. ولما شربتُها، نطق قلبي بالفهم، ونمت الحكمة في صدري، إذ احتفظت روحي بذاكرتها.",
      "review_notes_ar": []
    }
  ]
}
