  "verses": [
    {
      "chapter": 7,
      "verse": 81,
      "text_ar": "الطريق الأول، لأنهم ازدراءوا شريعة العلي.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 82,
      "text_ar": "الطريق الثاني، لأنهم لا يستطيعون الآن تقديم توبة مقبولة لكي يحبوا.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 83,
      "text_ar": "الطريق الثالث، سيرون الجزاء المعدّ لأولئك الذين آمنوا بعهود العلي.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 84,
      "text_ar": "الطريق الرابع، سيتأملون العذاب المعدّ لهم في الأيام الأخيرة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 85,
      "text_ar": "الطريق الخامس، سيرون مساكن الآخرين محروسة من الملائكة في طمأنينة عظيمة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 86,
      "text_ar": "الطريق السادس، سيرون كيف يعبر بعضهم فوراً إلى العذاب.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 87,
      "text_ar": "الطريق السابع، وهو أشد قسوة من كل الطرق المذكورة آنفاً، لأنهم سيذوبون في الارتباك ويحترقون بالخزي، وتذويهم المخاوف، إذ يرون مجد العلي الذي أخطأوا أمامه وهم أحياء، والذي سيُدانونه أمامه في الأزمان الأخيرة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 88,
      "text_ar": "\"والآن هذا هو ترتيب الذين حفظوا طرق العلي، عندما ينفصلون عن جسدهم المائت.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 89,
      "text_ar": "في الوقت الذي عاشوا فيه فيه، خدموا العلي بمشقة، وكانوا في خطر في كل ساعة، لكي يحفظوا شريعة الواضع بإتقان.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 90,
      "text_ar": "لذلك فهذا هو التعليم بشأنهم:",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 91,
      "text_ar": "أول كل شيء سيرون بفرح عظيم مجد ذاك الذي يرفعهم، لأنهم سيستريحون في سبعة مراتب.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 92,
      "text_ar": "المرتبة الأولى، لأنهم جاهدوا بجهد عظيم للتغلب على الفكر الشرير الذي صُور معهم، لكيلا يضلهم عن الحياة إلى الموت.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 93,
      "text_ar": "المرتبة الثانية، لأنهم يرون الحيرة التي تتجول فيها نفوس الأشرار، والعقاب المنتظر لهم.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 94,
      "text_ar": "المرتبة الثالثة، يرون الشهادة التي يشهد بها صانعهم من جهتهم، بأنهم في حياتهم حفظوا الشريعة التي أودعت لديهم أمانة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 95,
      "text_ar": "المرتبة الرابعة، يدركون الراحة التي يتمتعون بها الآن وهم مجتمعون في مخادعهم بطمأنينة عظيمة، محروسين بالملائكة، والمجد المنتظر لهم في الأيام الأخيرة.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 96,
      "text_ar": "المرتبة الخامسة، يفرحون لأنهم نجوا الآن مما هو قابل للفساد، وأنهم سيرثون ما هو آتٍ، بينما يرون فوق ذلك الصعوبة والألم اللذين نُجوا منهما، والحرية الواسعة التي ينالونها بفرح وعدم فساد.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 97,
      "text_ar": "المرتبة السادسة، حين يُظهر لهم كيف ستشرق وجوههم مثل الشمس، وكيف سيصيرون كضياء النجوم، غير قابلين للفساد منذ ذلك الحين.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 98,
      "text_ar": "المرتبة السابعة، وهي أعظم من جميع المراتب المذكورة سابقاً، لأنهم سيفرجون بثقة، ولأنهم سيجرؤون بلا ارتباك، ويفرحون بلا خوف، لأنهم يسرعون ليروا وجه ذاك الذي خدموه في حياتهم، ومنه ينالون جزاءهم في المجد.",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 99,
      "text_ar": "هذا هو ترتيب نفوس الأبرار، كما يُعلن لهم من الآن فصاعداً. وسبق ذكر طرق العذاب التي سيعاني منها أولئك الذين لم يصغوا بعد هذا.\"",
      "review_notes_ar": []
    },
    {
      "chapter": 7,
      "verse": 100,
      "text_ar": "فأجبت وقُلْت: \"أَفَتُعْطَى إذن مُهْلَةٌ للنفس بعد انفصالها عن الأجساد، لكي ترى ما وصفتَهُ لي؟\"",
      "review_notes_ar": []
    }
  ]
}
