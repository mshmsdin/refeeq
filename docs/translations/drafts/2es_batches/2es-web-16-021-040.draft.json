  "verses": [
    {
      "chapter": 16,
      "verse": 21,
      "text_ar": "هوذا، سيكون الطعام زهيداً جداً على الأرض لدرجة أنهم سيظنون أنهم في حال حسنة، وحينئذ أيضاً ستتزايد البلايا على الأرض: السيف، والمجاعة، والاضطراب العظيم.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 22,
      "text_ar": "لأن كثيرين ممن يسكنون على الأرض سيهلكون بالمجاعة، ومن ينجون من المجاعة سيهلكهم السيف.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 23,
      "text_ar": "ستطرح الجثث كالزبل، ولن يكون هناك من يعزيها؛ لأن الأرض ستترك خراباً، وستهدم مدنها.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 24,
      "text_ar": "لن يبقى فلاح لفلاحة الأرض أو لبذرها.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 25,
      "text_ar": "ستعطي الأشجار ثماراً، ولكن من سيجنيها؟",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 26,
      "text_ar": "ستنضج العناقيد، ولكن من يدوسها؟ لأنه في كل الأماكن ستكون هناك وحشة عظيمة؛",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 27,
      "text_ar": "إذ سيرغب الإنسان في رؤية أخيه، أو سماع صوته.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 28,
      "text_ar": "لأنه سيبقى من المدينة عشرة، ومن الحقل اثنان، ممن اختبأوا في الغابات الكثيفة وفي شقوق الصخور.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 29,
      "text_ar": "وكما أنه في بستان زيتون قد يبقى في كل شجرة ثلاث أو أربع زيتونات،",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 30,
      "text_ar": "أو كما أنه عندما يُقطف كرم، تتبقى بعض العناقيد لمن يبحثون باجتهاد في الكرم،",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 31,
      "text_ar": "هكذا أيضاً في تلك الأيام، سيتبقى ثلاثة أو أربعة ممن يبحثون في بيوتهم بالسيف.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 32,
      "text_ar": "ستترك الأرض خراباً، وتكون حقولها للعوسج، وتنمو الشوك في طرقها وكل مسالكها، لأنه لن يمر بها غنم.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 33,
      "text_ar": "ستنوح العذارى إذ ليس لهن عرسان. وتنوح النساء إذ ليس لهن أزواج. وتنوح بناتهن إذ ليس لهن معينون.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 34,
      "text_ar": "سيهلك عرسانهن في الحروب، ويهلك أزواجهن بالمجاعة.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 35,
      "text_ar": "اسمعوا الآن هذه الأمور، وافهموها يا عبيد الرب.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 36,
      "text_ar": "هوذا كلمة الرب: اقبلوها. لا تشككوا في الأمور التي يتكلم بها الرب.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 37,
      "text_ar": "هوذا البلايا تقترب ولا تتأخر.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 38,
      "text_ar": "كما أن المرأة الحامل في الشهر التاسع، عندما تقترب ساعة ولادتها، تحيط برحمها أوجاع عظيمة في غضون ساعتين أو ثلاث، وعندما يخرج الطفل من الرحم لا يكون هناك أي إبطاء ولو للحظة،",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 39,
      "text_ar": "هكذا أيضاً لن تتأخر البلايا في الحلول على الأرض. وسيئن العالم، وتستولى عليه الأوجاع من كل جانب.",
      "review_notes_ar": []
    },
    {
      "chapter": 16,
      "verse": 40,
      "text_ar": "«يا شعبي، اسمع كلمتي: استعدوا للحرب، وكونوا في تلك البلايا مثل الغرباء على الأرض.",
      "review_notes_ar": []
    }
  ]
}
