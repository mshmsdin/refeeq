  "verses": [
    {
      "chapter": 3,
      "verse": 21,
      "text_ar": "فقد خالف آدم الأول، وقد كان مثقلًا بقلب فاسد، فخُلب وغُلب، وكذلك الجميع المنحدرون منه.",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 22,
      "text_ar": "فصارت الأمراض دائمة. وكان الناموس في قلب الشعب مع شر الجذر، فمضى الذي هو صالح وبقي الذي هو شرير.",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 23,
      "text_ar": "فمضت الأزمنة واكتملت السنوات، ثم أعددت عبدًا اسمه داود،",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 24,
      "text_ar": "فأمَرته أن يقيم مدينةً لاسمك، وأن يُقدّم لك فيها محرقات مما لك.",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 25,
      "text_ar": "فلمّا تمّ هذا بعد سنين، عمل أسوان المدينة الشرّ،",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 26,
      "text_ar": "فرضة جميع الأمور التي عملها آدم فابنوه، لأَن لهم قلوبًا شريرة.",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 27,
      "text_ar": "فأمنت مدينتك بيد أعدائك.",
      "review_notes_ar": [
        "يجب إصلاح 'أمنت' إلى 'سلّمت' في النص المترجم النهائي، هذا مجرد اقتراح للمراجعة."
      ]
    },
    {
      "chapter": 3,
      "verse": 28,
      "text_ar": "ثم قلت في قلبي: أوَهَلْ تفوق أعمال ساكني بابل؟ ولماذا سادوا على صهيون؟",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 29,
      "text_ar": "فحدث أنه لما أقبلت إلى هنا رأيت أيضًا أمواجًا لا تُحصى، ورأت روحي خطاةً كثيرين في هذه السنة الثلاثين، فأخنقت قلبي.",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 30,
      "text_ar": "لأنني رأيت كيف صبرت على ذنوبهم، ونجيت غير المقنّعين، وأهلكت قومك، وحفظت أعداءك.",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 31,
      "text_ar": "ولم تُظهر كيف تُفهم طرقك، أوأعمل بابل أفضلُ من أعمال صهيون؟",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 32,
      "text_ar": "أوأيّ أمةٍ أخرى علمتك إلا إسرائيل؟ أوأيّ قبائلٍ صدقتِ أحقادك كهذه قبائل يعقوب؟",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 33,
      "text_ar": "وَلَكِن لا يبدو ثوابهم، ومشقتهم بلا ثمر، لأنني جُلتُ هناّ وهناك في الشعوب، فأبصرهم يكثرُ أغنياءًا، ولا يفكرون في وصاياك.",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 34,
      "text_ar": "فważن الآن خطاياهم في الميزان، وكذلك هي الساكنين في العالم، فيُرى أيّ جانبٍ يترجح الميزان إليه.",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 35,
      "text_ar": "ومتى لم يعصي الساكنون في الأرض دونك؟ أوأيّة أمةٍ حفظت أوامرك هكذا؟",
      "review_notes_ar": []
    },
    {
      "chapter": 3,
      "verse": 36,
      "text_ar": "وتجد رجَالاً بأسمائهم حفظوا وصاياك، ولكن لا تجد أمماً.",
      "review_notes_ar": []
    }
  ]
}
