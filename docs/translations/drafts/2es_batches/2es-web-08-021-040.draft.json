  "verses": [
    {
      "chapter": 8,
      "verse": 21,
      "text_ar": "الذي عرشه لا يُقاس، ومجده لا يُدرك، والذي تقف أمامَه جنود الملائكة مرتعشة،",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 22,
      "text_ar": "الذين بأمره يتحولون إلى ريح ونار، وكلمته ثابتة، وأقواله راسخة، وأحكامه قوية، ووصيته مخيفة،",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 23,
      "text_ar": "الذي بنظرته تجف الأعماق، وبسخطه تذوب الجبال، وحقّه يشهد،",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 24,
      "text_ar": "اسمع، يا رب، صلاة عبدك، وأصغِ إلى طلبة صنع يديك.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 25,
      "text_ar": "انتبه إلى أقوالي، فما دمتُ حياً سأتكلم، وما دام لي فهمٌ سأجيب.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 26,
      "text_ar": "لا تنظر إلى خطايا شعبك، بل إلى الذين خدموك بالحق.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 27,
      "text_ar": "لا تلتفت إلى أفعال أولئك الذين يصنعون الشر، بل إلى الذين حفظوا عهودك في الضيق.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 28,
      "text_ar": "لا تفكر في أولئك الذين عاشوا بالشر قدامك، بل تذكر الذين عرفوا مخافتك طوعاً.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 29,
      "text_ar": "لا تكن إرادتك أن تهلك الذين عاشوا كالبهائم، بل انظر إلى الذين علموا ناموسك بوضوح.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 30,
      "text_ar": "لا تغضب على الذين يُحسبون أسوأ من الحيوانات، بل أحبَّ الذين وضعوا رجاءهم دائماً في مجدك.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 31,
      "text_ar": "فإننا نحن وآباءنا قد قضينا أيام حياتنا في طرق تجلب الموت، أما أنت فتُدعى رحيماً لأجلنا نحن الخطاة.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 32,
      "text_ar": "فإن كانت رغبتك أن ترحمنا نحن الذين ليس لنا أعمال برّ، فحينئذ تُدعى رحيماً.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 33,
      "text_ar": "لأن الأبرار الذين وُضعت لهم أعمال صالحة كثيرة عندك، سينالون مكافأة عن أعمالهم الخاصة.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 34,
      "text_ar": "فما هو الإنسان حتى تغضب عليه؟ وما هو الجنس الفاسد حتى تقسو عليه هكذا؟",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 35,
      "text_ar": "لأنه حقاً، ليس بين المواليد إنسان لم يصنع الشر، ولا يوجد بين الذين عاشوا من لم يرتكب الإثم.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 36,
      "text_ar": "لأن في هذا يا رب، سيُعلن برّك وصلاحك، إن رحمتَ الذين ليس لديهم رصيد من الأعمال الصالحة».",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 37,
      "text_ar": "ثم أجابني قائلاً: «أنت تكلمت ببعض الأمور بالحق، وسيكون الأمر بحسب أقوالك.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 38,
      "text_ar": "فإني حقاً لن أفكر في تكوين الذين خطئوا، ولا في موتهم، أو دينونتهم، أو هلاكهم؛",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 39,
      "text_ar": "بل سأفرح بخليقة الأبرار وغربتهم، وخلاصهم، والمكافأة التي سيعانونها.",
      "review_notes_ar": []
    },
    {
      "chapter": 8,
      "verse": 40,
      "text_ar": "لذلك كما تكلمت، هكذا سيكون.",
      "review_notes_ar": []
    }
  ]
}
