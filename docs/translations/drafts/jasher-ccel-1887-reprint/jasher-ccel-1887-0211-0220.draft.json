  "units": [
    {
      "text_ar": "وهؤلاء أسماء أبناء نوح: يافث، وحام، وشيم؛ وُلد لهم أولاد بعد الطوفان، لأنهم قد أخذوا نساء قبل الطوفان.",
      "chapter": 7,
      "source_ref": "7:1"
    },
    {
      "text_ar": "هؤلاء أبناء يافث: قمر، ماجوج، ماداي، يافان، طوبال، مشح، وتيراس، سبعة أبناء.",
      "chapter": 7,
      "source_ref": "7:2"
    },
    {
      "text_ar": "وأبناء قمر هم أسكيناز، ريفاث وتجارما.",
      "chapter": 7,
      "source_ref": "7:3"
    },
    {
      "text_ar": "وأبناء ماجوج هم إليكاناف ولوبال.",
      "chapter": 7,
      "source_ref": "7:4"
    },
    {
      "text_ar": "وأولاد ماداي هم أكون، زيلو، خازوني ولوط.",
      "chapter": 7,
      "source_ref": "7:5"
    },
    {
      "text_ar": "وأبناء يافان هم إليشا، ترشيش، شطيم ودودونيم.",
      "chapter": 7,
      "source_ref": "7:6"
    },
    {
      "text_ar": "وأبناء طوبال هم أريفي، كيسد وتاري.",
      "chapter": 7,
      "source_ref": "7:7"
    },
    {
      "text_ar": "وأبناء مشح هم ديدون، زارون وشباشني.",
      "chapter": 7,
      "source_ref": "7:8"
    },
    {
      "text_ar": "وأبناء تيراس هم بنب، جيرا، لبيريون وجيلك؛ هؤلاء هم أبناء يافث بحسب عائلاتهم، وكان عددهم في ذلك الوقت حوالي أربعمائة وستين رجلاً.",
      "chapter": 7,
      "source_ref": "7:9"
    },
    {
      "text_ar": "وهؤلاء أبناء حام: كوش، مصر، فوت وكانعان، أربعة أبناء؛ وأبناء كوش هم سبة، حافيلاه، سبتا، رعام وساتكة، وأبناء رعام هم شبة وديدان.",
      "chapter": 7,
      "source_ref": "7:10"
    }
  ]
}
