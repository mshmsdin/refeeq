  "units": [
    {
      "text_ar": "وقالوا لإنوخ ما رأوا، فأجاب إينوخ لهم: هل هذا الحصان ينزل إلى الأرض من أجلِّي؟ لقد حان الوقت لأغادركم ولن أُرى منكم بعد ذلك.",
      "chapter": 3,
      "source_ref": "3:28"
    },
    {
      "text_ar": "في ذلك الوقت نزل الحصان ووقف أمام إينوخ، ورأى جميع أبناء البشر الذين كانوا معه.",
      "chapter": 3,
      "source_ref": "3:29"
    },
    {
      "text_ar": "قال إينوخ مرة أخرى للناس صوتاً مبثوثاً، قائلاً: أين هو الرجل الذي يستمتع بمعرفة طرق الرب إلهه؟ فليأتِ هذا اليوم إلى إينوخ قبل أن يُخذ منا.",
      "chapter": 3,
      "source_ref": "3:30"
    },
    {
      "text_ar": "جميع أبناء البشر تجمّعوا وذهبوا إلى إينوخ ذلك اليوم؛ وكل ملوك الأرض مع أمرائهم ومستشارهم ظلوا معه ذلك اليوم؛ وعلّمت إينوخ أبناء البشر الحكمة والمعرفة، ومنحهم تعليمًا إلهيًا؛ فأمرهم أن يعبدوا الرب ويعتمدوا طرقه طوال أيام حياتهم، واستمر في إرساء السلام بينهم.",
      "chapter": 3,
      "source_ref": "3:31"
    },
    {
      "text_ar": "وبعد ذلك ارتفع على الحصان، وتوجه، وذهب معه جميع أبناء البشر، نحو ثمانية مائة ألف رجل؛ وسافروا معه رحلة يوم واحد.",
      "chapter": 3,
      "source_ref": "3:32"
    },
    {
      "text_ar": "في اليوم الثاني قال لهم: عدوا إلى خيامكم، لماذا تذهبون؟ ربما تموتون؛ فأحدهم ابتعد عنهم، والباقون سافروا معه ستة أيام؛ وقال إينوخ لهم كل يوم: عدوا إلى خيامكم، لتجنبوا الموت؛ لكنهم لم يرغبوا في العودة، وسافروا معه.",
      "chapter": 3,
      "source_ref": "3:33"
    },
    {
      "text_ar": "في اليوم السادس بقي بعض الرجال معه، وتشبّثوا به، وقالوا له: سوف نسير معك إلى المكان الذي تذهب إليه؛ كما هو حي الرب، فالموت فقط سيفرّقنا.",
      "chapter": 3,
      "source_ref": "3:34"
    },
    {
      "text_ar": "وتسعّدوا بشدة للسير معه، فوقف عن الحديث معهم؛ فذهبوا معه ولم يعودوا.",
      "chapter": 3,
      "source_ref": "3:35"
    },
    {
      "text_ar": "وعندما عاد الملوك، أجبروا على إجراء تعداد لمعرفة عدد الرجال الذين ظلوا مع إينوخ؛ وفي اليوم السابع صعد إينوخ إلى السماء في دوامة، مع الخيول والطوارئ النارية.",
      "chapter": 3,
      "source_ref": "3:36"
    },
    {
      "text_ar": "في اليوم الثامن أرسل كل الملك الذي كان مع إينوخ للعودة وتحضير عدد الرجال الذين كان معهم في المكان الذي صعد منه إلى السماء.",
      "chapter": 3,
      "source_ref": "3:37"
    }
  ]
}
