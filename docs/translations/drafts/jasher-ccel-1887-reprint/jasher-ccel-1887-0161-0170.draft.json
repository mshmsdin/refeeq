  "units": [
    {
      "text_ar": "وها أنا أُحضر طوفاناً من المياه على الأرض، وتُدمّر كل الكائنات، فمن تحت السماوات، كل ما على الأرض سيتلاشى.",
      "chapter": 5,
      "source_ref": "5:29"
    },
    {
      "text_ar": "أنت وأفراد عائلتك ستذهب وتجمع زوجين من كل الكائنات الحية، ذكوراً وأنثى، وتأتيهم إلى الفلك، لتستخرج منها ذرية على الأرض.",
      "chapter": 5,
      "source_ref": "5:30"
    },
    {
      "text_ar": "وجمع لك جميع الطعام الذي تأكله جميع الحيوانات، حتى يكون الطعام لك ولهم.",
      "chapter": 5,
      "source_ref": "5:31"
    },
    {
      "text_ar": "تختار لابنائك ثلاث عذارٍ، من بنات الرجال، ليكونوا زوجات لابنائك.",
      "chapter": 5,
      "source_ref": "5:32"
    },
    {
      "text_ar": "نهض نوح، وأجلب الفلك، في المكان الذي أمره الله به، وفعَل نوح ما أمره الله.",
      "chapter": 5,
      "source_ref": "5:33"
    },
    {
      "text_ar": "في سنه الخمسمائة و وخمسون سنة، بدأ نوح في بناء الفلك، وأنجزه خلال خمس سنوات، كما أمره الرب.",
      "chapter": 5,
      "source_ref": "5:34"
    },
    {
      "text_ar": "ثم أخذ نوح ثلاث بنات لعليام، ابن متمثال، كزوجات لأبنائه، كما أمر الرب نوح.",
      "chapter": 5,
      "source_ref": "5:35"
    },
    {
      "text_ar": "وكان ذلك حين توفي متمثال، ابن إنوخ، عند سن تسعمائة وستين سنة، عند وفاته.",
      "chapter": 5,
      "source_ref": "5:36"
    },
    {
      "text_ar": "في ذلك الوقت، بعد وفاة متمثال، قال الرب لنوح: اذهب مع عائلتك إلى الفلك؛ فأنا أُجمع لك جميع حيوانات الأرض، وحيوانات المدى وتريّال الريح، وستجتمع كلها حول الفلك.",
      "chapter": 6,
      "source_ref": "6:1"
    },
    {
      "text_ar": "وستذهب وتجلس عند أبواب الفلك، وستجتمع جميع الوحوش والحيوانات والتريّال، وتضع نفسها أمامك، وستأخذ وتُسلم في يد أبنائك، الذين سيجلبونها إلى الفلك، وكل ما يقف أمامك ستتركه.",
      "chapter": 6,
      "source_ref": "6:2"
    }
  ]
}
