  "units": [
    {
      "text_ar": "ومات جميع الرجال الذين سلكوا طرق الرب في تلك الأيام، قبل أن يجلب الرب الشر إلى الإنسان الذي أعلن عنه، فكان ذلك من عند الرب، لكي لا يروا الشر الذي تكلم به الرب عن بني الناس.",
      "source_ref": "4:20",
      "chapter": 4
    },
    {
      "text_ar": "ووجد نوح نعمة في نظر الرب، واختاره الرب هو وأولاده ليخرج من نسلهم سلالة على وجه الأرض كلها.",
      "source_ref": "4:21",
      "chapter": 4
    },
    {
      "text_ar": "وكان ذلك في السنة الثمانين والأربعين من عمر نوح، حين مات حنّوك ابن شيث، وكان عمره تسعمائة وخمس سنوات عند وفاته.",
      "source_ref": "5:1",
      "chapter": 5
    },
    {
      "text_ar": "وفي السنة المئة وتسعة وسبعين من عمر نوح، مات كاينان ابن إنوش، وكان عمر كاينان تسعمائة وعشر سنوات، فمات.",
      "source_ref": "5:2",
      "chapter": 5
    },
    {
      "text_ar": "وفي السنة المئتين والثلاثة والثلاثين من عمر نوح، مات مهلّيل ابن كاينان، وكان عمر مهلّيل ثمانمائة وخمس وتسعين سنة، فمات.",
      "source_ref": "5:3",
      "chapter": 5
    }
  ]
