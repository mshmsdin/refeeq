  "units": [
    {
      "chapter": 7,
      "source_ref": "7:11",
      "text_ar": "وكان أولاد مِصر لود، أنوم وباثروس، تشاسلوث وشافتور."
    },
    {
      "chapter": 7,
      "source_ref": "7:12",
      "text_ar": "وكان أولاد فُوت جيبول، هادان، بِنَّة وعَدَن."
    },
    {
      "chapter": 7,
      "source_ref": "7:13",
      "text_ar": "وكان أولاد كنعان زِدُون، هيث، أموري، جرغاشي، هيفي، أركي، سيني، أرودي، زيمودي وشاموثي."
    },
    {
      "chapter": 7,
      "source_ref": "7:14",
      "text_ar": "هؤلاء هم أولاد حام بحسب عائلاتهم، وكان عددهم في ذلك الوقت نحو سبعمائة وثلاثين رجلاً."
    },
    {
      "chapter": 7,
      "source_ref": "7:15",
      "text_ar": "وهؤلاء هم أولاد شيم: عِلَام، آشور، أرباخشاد، لود وعَرام، خمسة أولاد؛ وكان أولاد عِلَام شوشان، ماخول وهرمون."
    },
    {
      "chapter": 7,
      "source_ref": "7:16",
      "text_ar": "وكان أولاد آشَر ميروس وموكيل، وكان أولاد أرباخشاد شِلاح، أنار وأشْكول."
    },
    {
      "chapter": 7,
      "source_ref": "7:17",
      "text_ar": "وكان أولاد لود بيثور وبيزايون، وكان أولاد عَرام أوز، خول، جاثر ومَش."
    },
    {
      "chapter": 7,
      "source_ref": "7:18",
      "text_ar": "هؤلاء هم أولاد شيم بحسب عائلاتهم؛ وكان عددهم في ذلك الوقت نحو ثلاثمائة رجل."
    },
    {
      "chapter": 7,
      "source_ref": "7:19",
      "text_ar": "هذه أجيال شيم؛ شيم أنجب أرباخشاد، وأرباخشاد أنجب شِلاح، وشِلاح أنجب إبر، وإبر كان له ولدان: أحدهما اسمه فِلق، لأن في أيامه انقسم أولاد البشر، وفي الأيام الأخيرة انقسمت الأرض."
    },
    {
      "chapter": 7,
      "source_ref": "7:20",
      "text_ar": "وكان اسم الثاني يُقْتَن، أي أن في أيامه قلّت حياة أولاد البشر وانخفضت."
    }
  ]
}
