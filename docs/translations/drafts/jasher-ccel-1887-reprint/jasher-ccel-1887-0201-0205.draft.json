  "units": [
    {
      "text_ar": "مرَّ ريحٌ فوق الأرض، فهدأت المياه واستراح الفلك.",
      "source_ref": "6:33",
      "chapter": 6
    },
    {
      "text_ar": "توقفت نوافير العمق ونوافذ السماء، وتكُدت الأمطار من السماء.",
      "source_ref": "6:34",
      "chapter": 6
    },
    {
      "text_ar": "نقصت المياه في تلك الأيام، واستراح الفلك على جبال أُرارط.",
      "source_ref": "6:35",
      "chapter": 6
    },
    {
      "text_ar": "فتح نوح حينئذٍ نوافذ الفلك، وما زال نوح يرفع صوته إلى الرب في ذلك الوقت وقال: يا رب، الذي خلق الأرض والسموات وكل ما فيها، أخرج أرواحنا من هذا السجن، ومن الحبس الذي وضعتنا فيه، فإنني أتعبتُ كثيرًا من التنهد.",
      "source_ref": "6:36",
      "chapter": 6
    },
    {
      "text_ar": "فاستمع الرب لصوت نوح، فقال له: عندما تُكمل سنةً كاملةً فحينئذٍ اخرج.",
      "source_ref": "6:37",
      "chapter": 6
    }
  ]
