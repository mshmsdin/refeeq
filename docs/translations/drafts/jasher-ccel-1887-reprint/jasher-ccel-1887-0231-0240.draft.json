  "units": [
    {
      "text_ar": "هؤلاء هم أبناء يوقتان؛ أموداد، شلاف، خزارموث، يراج، هادوروم، أوزيل، دكلاه، أوبال، أبيمايل، شبا، أوبير، هافيل، وجوباب؛ جميعهم أبناء يوقتان.",
      "chapter": 7,
      "source_ref": "7:21"
    },
    {
      "text_ar": "وقد أنجب بيليج أخاه يين، وأنجب يين سيروغ، وأنجب سيروغ ناحور، وأنجب ناحور تراه، وقد كان تراه في عمره ثمانية وثلاثين سنة، وأنجبه هاران وناحور.",
      "chapter": 7,
      "source_ref": "7:22"
    },
    {
      "text_ar": "وأخذ كوش ابن حام، ابن نوح، في تلك الأيام زوجة في سنه المتأخرة، فأخذت منه ابنًا، وسموا اسمه نمرود، قائلين: في ذلك الوقت بدأت أبناء البشر مرة أخرى بالتمرد والتجاوز على الله، ونمو الطفل، وأحب والده عليه كثيرًا، لأنه ابن سنه المتأخرة.",
      "chapter": 7,
      "source_ref": "7:23"
    },
    {
      "text_ar": "وعندما خرجوا من الحديقة، أعطى الله ملابس الجلد لآدم وزوجته، فتم تسليمها لكوش.",
      "chapter": 7,
      "source_ref": "7:24"
    },
    {
      "text_ar": "بعد وفاة آدم وزوجته، أُعطيت الملابس لإنوك، ابن يارد، وعندما حمله الله، أعطاها إلى متهوسه، ابنه.",
      "chapter": 7,
      "source_ref": "7:25"
    },
    {
      "text_ar": "وعند وفاة متهوسه، أخذ نوحها وأحضرها إلى الفلك، وكانت معه حتى خرج من الفلك.",
      "chapter": 7,
      "source_ref": "7:26"
    },
    {
      "text_ar": "وعند خروجهم سرق حام تلك الملابس من نوح، والآب، وأخذها وخفيتها عن إخوته.",
      "chapter": 7,
      "source_ref": "7:27"
    },
    {
      "text_ar": "وعندما أنجب حام ابنه الأول كوش، أعطاه الملابس في السر، وكانت مع كوش لعدة أيام.",
      "chapter": 7,
      "source_ref": "7:28"
    },
    {
      "text_ar": "وكان كوش يخفها أيضًا عن أبنائه وإخوته، وعندما أنجب كوش نمرود، أعطاه هذه الملابس عبر حبه له، ونمرود نمت، وعندما كان في العشرين سنة ارتدى تلك الملابس.",
      "chapter": 7,
      "source_ref": "7:29"
    },
    {
      "text_ar": "وبقي نمرود قويًا عندما ارتدى الملابس، وأعطاه الله قوة وقوة، وكان صيادًا قويًا على الأرض، نعم، كان صيادًا قويًا في الحقل، وصار صيادًا على الحيوانات وبنى مذبحًا، وأقدّم عليها الحيوان أمام الرب.",
      "chapter": 7,
      "source_ref": "7:30"
    }
  ]
}
