# ==============================================================================
# Environment Configuration Template for «رفيق المناظر» (The Debater's Companion)
# Copy this file to .env or configure directly in Coolify Environment Variables.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public URL (for links / CORS / reverse-proxy awareness)
APP_URL=https://debates.yourdomain.com

# Persistent Storage Paths (Coolify Persistent Volumes)
DB_PATH=/app/data/library.db
ARCHIVE_PATH=/app/data/archive
# Path to the media/images directory (REQUIRED for images to show)
# In Docker/Coolify: mount a volume and point this to the mounted path
MEDIA_PATH=/app/data/media

# Optional Database URL (if switching to PostgreSQL resource in Coolify)
# DATABASE_URL=postgresql://user:password@postgres:5432/rafeeq_db
